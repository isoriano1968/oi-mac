packages/**/gcc-[0-9]*.[0-9]*/
packages/**/binutils-[0-9]*.[0-9]*/
packages/**/amix-userland-*/
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.log
*.o
*.p5p

# Apple/AMD VBIOS images (ACPI VFCT dump from the Mac Pro): keep local
notes/macpro-2013/VFCT.bin
# Mac Pro ACPI tables and the Linux live dmesg (firmware, MAC addresses): keep local
notes/macpro-2013/acpi-tables/
notes/macpro-2013/linux-*.txt
notes/macpro-2013/dpm6/dpm6-boot-messages.txt
