# build trees, downloads and local package repositories: never in git
build/
/archives/
/i386/
/sparc/
/work/
/distfiles/
# upstream sources unpacked into a component directory by "gmake prep"
packages/**/gcc-[0-9]*.[0-9]*/
packages/**/binutils-[0-9]*.[0-9]*/
packages/**/amix-userland-*/
# binaries and archives
*.tar.gz
*.tar.xz
*.tar.bz2
*.tgz
*.zip
*.p5p
*.o
*.so
*.so.*
*.a
*.bin
*.rom
*.adf
*.hdf
*.iso
*.log
# private files (addresses, access details, correspondence): the name
# carries ".local", and they are never published
*.local
*.local.*
# Mac Pro firmware tables, VBIOS images and raw Linux/boot logs (MAC
# addresses, machine identifiers): keep local
notes/macpro-2013/VFCT.bin
notes/macpro-2013/acpi-tables/
notes/macpro-2013/linux-*.txt
notes/macpro-2013/dpm6/dpm6-boot-messages.txt
notes/macpro-2013/sram*/sram-lines.txt
