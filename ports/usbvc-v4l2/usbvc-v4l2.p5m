# Our driver/graphics/usbvc: the same package name, files and driver action
# as OpenIndiana's, at a higher version ($(OSNET_VERSION).1) in our
# publisher, with the patched module and man page (patches/).  The
# incorporate dependency ties it to the OS build it was built for.  See the
# Makefile and notes/usbvc-v4l2-webcam.md.

set name=pkg.fmri value=pkg:/driver/graphics/usbvc@$(PKG_VERSION)
set name=pkg.summary value="USB Video Class Driver (V4L2 for Chromium and GStreamer)"
set name=pkg.description \
    value="illumos usbvc from illumos-gate $(GATE_SHORT) with frame size and interval enumeration, poll(2), UVC frame based formats, 720p on xhci, buffer sequence numbers and timestamps, and the Linux struct v4l2_buffer layout (OpenIndiana project)"
set name=pkg.human-version value="$(GATE_SHORT)+v4l2"
set name=info.classification value=org.opensolaris.category.2008:Drivers/Media
set name=illumos-gate.info.git-remote value=https://github.com/illumos/illumos-gate.git
set name=illumos-gate.info.git-rev value=$(GATE_COMMIT)
set name=variant.arch value=i386
set name=org.opensolaris.consolidation value=osnet
set name=variant.opensolaris.zone value=global value=nonglobal

dir path=kernel group=sys mode=0755 owner=root variant.opensolaris.zone=global
dir path=kernel/drv group=sys mode=0755 owner=root variant.opensolaris.zone=global
dir path=kernel/drv/amd64 group=sys mode=0755 owner=root \
    variant.opensolaris.zone=global
file usbvc path=kernel/drv/amd64/usbvc group=sys mode=0755 owner=root \
    reboot-needed=true variant.opensolaris.zone=global
dir path=usr/share/man group=bin mode=0755 owner=root
dir path=usr/share/man/man4d group=bin mode=0755 owner=root facet.doc.man=true
file usbvc.4d path=usr/share/man/man4d/usbvc.4d group=bin mode=0444 \
    owner=root facet.doc.man=true restart_fmri=svc:/system/update-man-index:default

driver name=usbvc perms="* 0666 root sys" alias=usbia46d,8c1.config1.0 \
    alias=usbia46d,8c2.config1.0 alias=usbia46d,8c3.config1.0 \
    alias=usbia46d,8c5.config1.0 alias=usbia,classe

license usbvc-v4l2.license license=CDDL

depend type=require fmri=pkg:/driver/usb@$(OSNET_VERSION) \
    variant.opensolaris.zone=global
depend type=incorporate \
    fmri=pkg:/consolidation/osnet/osnet-incorporation@$(OSNET_VERSION)
