+	cnt = frame->bFrameIntervalType;
+	if (cnt > 0) {
+		/* discrete frame intervals */
+		if (fival->index >= cnt) {
+			mutex_exit(&usbvcp->usbvc_mutex);
+
+			return (EINVAL);
