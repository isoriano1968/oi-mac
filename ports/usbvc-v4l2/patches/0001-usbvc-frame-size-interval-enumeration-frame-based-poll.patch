+/*
+ * usbvc_chpoll:
+ *	poll(2) entry point: readable when a filled buffer waits for
+ *	VIDIOC_DQBUF (mmap I/O) or read(2). V4L2 applications such as
+ *	Chromium poll before they dequeue.
+ */
+static int
+usbvc_chpoll(dev_t dev, short events, int anyyet, short *reventsp,
+    struct pollhead **phpp)
+{
+	usbvc_state_t	*usbvcp =
+	    ddi_get_soft_state(usbvc_statep, getminor(dev));
+	usbvc_stream_if_t	*strm_if;
+	usbvc_buf_grp_t	*bufgrp;
+	short		revents = 0;
+
+	if (usbvcp == NULL) {
+
+		return (ENXIO);
+	}
+
+	mutex_enter(&usbvcp->usbvc_mutex);
+	strm_if = usbvcp->usbvc_curr_strm;
+	if (usbvcp->usbvc_dev_state == USB_DEV_DISCONNECTED) {
+		revents = POLLHUP | POLLERR;
+	} else if (strm_if != NULL) {
+		if (usbvcp->usbvc_io_type == V4L2_MEMORY_MMAP) {
+			bufgrp = &strm_if->buf_map;
+		} else {
+			bufgrp = &strm_if->buf_read;
+		}
+		if (!list_is_empty(&bufgrp->uv_buf_done)) {
+			revents = events & (POLLIN | POLLRDNORM);
+		}
+	}
+	mutex_exit(&usbvcp->usbvc_mutex);
+
+	*reventsp = revents;
+	if ((revents == 0 && !anyyet) || (events & POLLET)) {
+		*phpp = &usbvcp->usbvc_pollhead;
+	}
+
+	return (0);
+}
