+{
+	usbvc_format_group_t	*fmtgrp;
+	usbvc_frames_t		*frame = NULL;
+	uint32_t		interval, min, max, step;
+	uint8_t			cnt;
+
+	mutex_enter(&usbvcp->usbvc_mutex);
+	fmtgrp = usbvc_v4l2_find_fmtgrp(usbvcp->usbvc_curr_strm,
+	    fival->pixel_format);
+	if (fmtgrp != NULL) {
+		frame = usbvc_v4l2_find_frame(fmtgrp, fival->width,
+		    fival->height);
+	}
+	if (frame == NULL) {
+		mutex_exit(&usbvcp->usbvc_mutex);
+
+		return (EINVAL);
+	}
