+		fival->type = (step == 1) ? V4L2_FRMIVAL_TYPE_CONTINUOUS :
+		    V4L2_FRMIVAL_TYPE_STEPWISE;
+		usbvc_v4l2_interval(min, &fival->stepwise.min);
+		usbvc_v4l2_interval(max, &fival->stepwise.max);
+		usbvc_v4l2_interval(step, &fival->stepwise.step);
+	}
+	bzero(fival->reserved, sizeof (fival->reserved));
 
 	return (0);
 }
