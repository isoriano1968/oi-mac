From 1c273196f8172431f051fa96ac482974166df40d Mon Sep 17 00:00:00 2001
From: isoriano1968 <81116077+isoriano1968@users.noreply.github.com>
Date: Mon, 9 Nov 2026 00:09:51 +0100
Subject: [PATCH 1/3] bge: keep BCM57766 status block and rings below 2 GB

Broadcom found that the BCM57766 can raise a spurious DMA address
overflow (and reset) on status block updates.  Linux tg3 works around it
with a 31-bit coherent DMA mask (614f4d166eee); do the same for bge's
DDI_DMA_CONSISTENT areas.
---
 usr/src/uts/common/io/bge/bge_main2.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/usr/src/uts/common/io/bge/bge_main2.c b/usr/src/uts/common/io/bge/bge_main2.c
index 8811ec1652..c50518768f 100644
--- a/usr/src/uts/common/io/bge/bge_main2.c
+++ b/usr/src/uts/common/io/bge/bge_main2.c
@@ -2090,16 +2090,30 @@ static int
 bge_alloc_dma_mem(bge_t *bgep, size_t memsize, ddi_device_acc_attr_t *attr_p,
 	uint_t dma_flags, dma_area_t *dma_p)
 {
+	ddi_dma_attr_t attr;
 	caddr_t va;
 	int err;
 
 	BGE_TRACE(("bge_alloc_dma_mem($%p, %ld, $%p, 0x%x, $%p)",
 	    (void *)bgep, memsize, attr_p, dma_flags, dma_p));
 
+	/*
+	 * The BCM57766 can flag a DMA address overflow, and reset itself,
+	 * when there is none: Broadcom traced it to status block updates
+	 * whose address has bits 16-31 all set after an update whose low
+	 * bits were all set.  As Linux tg3 does (614f4d166eee, 2024), keep
+	 * the consistent areas (status block, statistics and descriptor
+	 * rings) below 2 GB on this chip.  Buffers are not affected.
+	 */
+	attr = dma_attr;
+	if ((dma_flags & DDI_DMA_CONSISTENT) != 0 &&
+	    bgep->chipid.device == DEVICE_ID_57766)
+		attr.dma_attr_addr_hi = 0x000000007FFFFFFFull;
+
 	/*
 	 * Allocate handle
 	 */
-	err = ddi_dma_alloc_handle(bgep->devinfo, &dma_attr,
+	err = ddi_dma_alloc_handle(bgep->devinfo, &attr,
 	    DDI_DMA_DONTWAIT, NULL, &dma_p->dma_hdl);
 	if (err != DDI_SUCCESS)
 		return (DDI_FAILURE);
