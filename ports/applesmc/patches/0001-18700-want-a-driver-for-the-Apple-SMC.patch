diff --git a/usr/src/uts/i86pc/io/applesmc.c b/usr/src/uts/i86pc/io/applesmc.c
new file mode 100644
index 00000000..3ac934f5
--- /dev/null
+++ b/usr/src/uts/i86pc/io/applesmc.c
@@ -0,0 +1,654 @@
+/*
+ * This file and its contents are supplied under the terms of the
+ * Common Development and Distribution License ("CDDL"), version 1.0.
+ * You may only use this file in accordance with the terms of version
+ * 1.0 of the CDDL.
+ *
+ * A full copy of the text of the CDDL should have accompanied this
+ * source.  A copy of the CDDL is also available via the Internet at
+ * http://www.illumos.org/license/CDDL.
+ */
+
+/*
+ * Copyright 2026 isoriano1968
+ */
+
+/*
+ * Apple System Management Controller (SMC), read only.
+ *
+ * Intel Macs describe the SMC in ACPI as device APP0001, with an I/O port
+ * window (normally 0x300-0x31f): the data port at the base and the
+ * command/status port at base + 4. The protocol is the one the Linux applesmc
+ * driver uses: send a command byte, the four key bytes and a length, then
+ * read the data bytes while the status port says data is waiting.
+ *
+ * The SMC runs the fans and thermal protection on its own; this driver never
+ * writes keys. It offers:
+ *
+ *  - one ksensor per temperature key ('T...', type sp78 or flt), so that the
+ *    temperatures show up in /dev/sensors/temperature/smc/ and in FMA;
+ *  - /dev/applesmc, with ioctls to count, enumerate, describe and read keys
+ *    (fans, power, voltages), for tools such as smcstat(8).
+ *
+ * The driver is a pseudo device that looks for APP0001 itself, as acpi_drv
+ * does for batteries; on machines without an SMC it does not attach.
+ */
+
+#include <sys/types.h>
+#include <sys/file.h>
+#include <sys/errno.h>
+#include <sys/open.h>
+#include <sys/cred.h>
+#include <sys/stat.h>
+#include <sys/conf.h>
+#include <sys/modctl.h>
+#include <sys/ddi.h>
+#include <sys/sunddi.h>
+#include <sys/sensors.h>
+#include <sys/sysmacros.h>
+#include <sys/acpi/acpi.h>
+#include <sys/acpica.h>
+#include <sys/applesmc.h>
+
+#define	SMC_DEFAULT_BASE	0x300
+#define	SMC_DATA(s)		((s)->smc_base)
+#define	SMC_CMD(s)		((s)->smc_base + 4)
+
+#define	SMC_CMD_READ		0x10
+#define	SMC_CMD_KEYBYIDX	0x12
+#define	SMC_CMD_KEYINFO		0x13
+
+#define	SMC_ST_AWAITING_DATA	0x01
+#define	SMC_ST_IB_CLOSED	0x02
+#define	SMC_ST_BUSY		0x04
+
+#define	SMC_MIN_WAIT		16	/* microseconds */
+#define	SMC_MAX_SENSORS		128
+#define	SMC_MAX_ERRORS		8	/* give up the sensor scan after this */
+
+typedef struct smc_sensor {
+	struct applesmc	*ss_smc;
+	char		ss_key[APPLESMC_KEYLEN];
+	char		ss_type[APPLESMC_KEYLEN];
+	uint8_t		ss_len;
+	id_t		ss_id;
+} smc_sensor_t;
+
+typedef struct applesmc {
+	dev_info_t	*smc_dip;
+	kmutex_t	smc_lock;
+	uint16_t	smc_base;
+	uint32_t	smc_nkeys;
+	uint_t		smc_nsensors;
+	smc_sensor_t	smc_sensors[SMC_MAX_SENSORS];
+} applesmc_t;
+
+static applesmc_t *applesmc;
+
+/*
+ * Wait until (status & mask) == val. The SMC usually answers within a few
+ * microseconds; back off up to about half a second before giving up.
+ */
+static int
+smc_wait(applesmc_t *smc, uint8_t val, uint8_t mask)
+{
+	clock_t us = SMC_MIN_WAIT;
+	int i;
+
+	for (i = 0; i < 24; i++) {
+		if ((inb(SMC_CMD(smc)) & mask) == val)
+			return (0);
+		if (us < 1000)
+			drv_usecwait(us);
+		else
+			delay(drv_usectohz(us));
+		if (i > 9)
+			us <<= 1;
+	}
+	return (EIO);
+}
+
+static int
+smc_send_cmd(applesmc_t *smc, uint8_t cmd)
+{
+	if (smc_wait(smc, 0, SMC_ST_IB_CLOSED) != 0)
+		return (EIO);
+	outb(SMC_CMD(smc), cmd);
+	return (0);
+}
+
+static int
+smc_send_byte(applesmc_t *smc, uint8_t b)
+{
+	if (smc_wait(smc, 0, SMC_ST_IB_CLOSED) != 0)
+		return (EIO);
+	/*
+	 * A separate read for BUSY after IB_CLOSED has fallen; folding both
+	 * into one wait can miss it when the SMC raises both at once.
+	 */
+	if (smc_wait(smc, SMC_ST_BUSY, SMC_ST_BUSY) != 0)
+		return (EIO);
+	outb(SMC_DATA(smc), b);
+	return (0);
+}
+
+/*
+ * Bring the SMC into a known idle state before a transaction.
+ */
+static int
+smc_sane(applesmc_t *smc)
+{
+	if (smc_wait(smc, 0, SMC_ST_BUSY) == 0)
+		return (0);
+	if (smc_send_cmd(smc, SMC_CMD_READ) != 0)
+		return (EIO);
+	return (smc_wait(smc, 0, SMC_ST_BUSY));
+}
+
+static int
+smc_xfer(applesmc_t *smc, uint8_t cmd, const uint8_t arg[APPLESMC_KEYLEN],
+    uint8_t *buf, uint8_t len)
+{
+	int i;
+
+	ASSERT(MUTEX_HELD(&smc->smc_lock));
+
+	if (smc_sane(smc) != 0)
+		return (EIO);
+	if (smc_send_cmd(smc, cmd) != 0)
+		return (EIO);
+	for (i = 0; i < APPLESMC_KEYLEN; i++) {
+		if (smc_send_byte(smc, arg[i]) != 0)
+			return (EIO);
+	}
+	/* Older SMCs need the length; newer ones (2012 on) ignore it. */
+	if (smc_send_byte(smc, len) != 0)
+		return (EIO);
+
+	for (i = 0; i < len; i++) {
+		if (smc_wait(smc, SMC_ST_AWAITING_DATA | SMC_ST_BUSY,
+		    SMC_ST_AWAITING_DATA | SMC_ST_BUSY) != 0)
+			return (EIO);
+		buf[i] = inb(SMC_DATA(smc));
+	}
+
+	/* Drain anything the SMC still wants to hand us. */
+	for (i = 0; i < 16; i++) {
+		drv_usecwait(SMC_MIN_WAIT);
+		if ((inb(SMC_CMD(smc)) & SMC_ST_AWAITING_DATA) == 0)
+			break;
+		(void) inb(SMC_DATA(smc));
+	}
+
+	return (smc_wait(smc, 0, SMC_ST_BUSY));
+}
+
+static int
+smc_read_key(applesmc_t *smc, const char *key, uint8_t *buf, uint8_t len)
+{
+	return (smc_xfer(smc, SMC_CMD_READ, (const uint8_t *)key, buf, len));
+}
+
+static int
+smc_key_info(applesmc_t *smc, const char *key, uint8_t *len, char *type,
+    uint8_t *flags)
+{
+	uint8_t info[6];
+	int ret;
+
+	if ((ret = smc_xfer(smc, SMC_CMD_KEYINFO, (const uint8_t *)key,
+	    info, sizeof (info))) != 0)
+		return (ret);
+	*len = info[0];
+	bcopy(&info[1], type, APPLESMC_KEYLEN);
+	*flags = info[5];
+	return (0);
+}
+
+static int
+smc_key_by_index(applesmc_t *smc, uint32_t idx, char *key)
+{
+	uint8_t be[4];
+
+	be[0] = idx >> 24;
+	be[1] = idx >> 16;
+	be[2] = idx >> 8;
+	be[3] = idx;
+	return (smc_xfer(smc, SMC_CMD_KEYBYIDX, be, (uint8_t *)key,
+	    APPLESMC_KEYLEN));
+}
+
+/*
+ * Convert a little-endian IEEE single ("flt ") to a value in 1/256 units,
+ * without using the FPU in the kernel.
+ */
+static int64_t
+smc_flt_to_q8(const uint8_t *b)
+{
+	uint32_t bits = b[0] | (b[1] << 8) | (b[2] << 16) |
+	    ((uint32_t)b[3] << 24);
+	int exp = (bits >> 23) & 0xff;
+	int64_t m = (bits & 0x7fffff) | 0x800000;
+	int shift;
+	int64_t v;
+
+	if (exp == 0 || exp == 0xff)
+		return (0);
+	/* value = m * 2^(exp - 150); times 256 = m * 2^(exp - 142) */
+	shift = exp - 142;
+	if (shift >= 32)
+		v = INT32_MAX;
+	else if (shift >= 0)
+		v = m << shift;
+	else if (shift > -32)
+		v = m >> -shift;
+	else
+		v = 0;
+	return ((bits & 0x80000000U) ? -v : v);
+}
+
+static int
+smc_temp_q8(applesmc_t *smc, smc_sensor_t *ss, int64_t *q8)
+{
+	uint8_t buf[4];
+	int ret;
+
+	mutex_enter(&smc->smc_lock);
+	ret = smc_read_key(smc, ss->ss_key, buf, ss->ss_len);
+	mutex_exit(&smc->smc_lock);
+	if (ret != 0)
+		return (ret);
+
+	if (bcmp(ss->ss_type, "sp78", 4) == 0)
+		*q8 = (int16_t)((buf[0] << 8) | buf[1]);
+	else
+		*q8 = smc_flt_to_q8(buf);
+	return (0);
+}
+
+static int
+smc_sensor_read(void *arg, sensor_ioctl_scalar_t *scalar)
+{
+	smc_sensor_t *ss = arg;
+	int64_t q8;
+	int ret;
+
+	if ((ret = smc_temp_q8(ss->ss_smc, ss, &q8)) != 0)
+		return (ret);
+	scalar->sis_unit = SENSOR_UNIT_CELSIUS;
+	scalar->sis_gran = 256;
+	scalar->sis_prec = 0;
+	scalar->sis_value = q8;
+	return (0);
+}
+
+static const ksensor_ops_t smc_temp_ops = {
+	.kso_kind = ksensor_kind_temperature,
+	.kso_scalar = smc_sensor_read
+};
+
+static boolean_t
+smc_key_ok(const char *key)
+{
+	int i;
+
+	for (i = 0; i < APPLESMC_KEYLEN; i++) {
+		if (key[i] < 0x20 || key[i] > 0x7e)
+			return (B_FALSE);
+	}
+	return (B_TRUE);
+}
+
+/*
+ * Register every temperature key that reads as a plausible value. Keys the
+ * board does not populate read as 0 or -127 and are skipped.
+ */
+static void
+smc_create_sensors(applesmc_t *smc)
+{
+	uint32_t i;
+	uint_t errors = 0;
+
+	for (i = 0; i < smc->smc_nkeys &&
+	    smc->smc_nsensors < SMC_MAX_SENSORS; i++) {
+		smc_sensor_t *ss = &smc->smc_sensors[smc->smc_nsensors];
+		char name[APPLESMC_KEYLEN + 1];
+		uint8_t flags;
+		int64_t q8;
+		int j, ret;
+
+		mutex_enter(&smc->smc_lock);
+		ret = smc_key_by_index(smc, i, ss->ss_key);
+		if (ret == 0 && ss->ss_key[0] == 'T' && smc_key_ok(ss->ss_key))
+			ret = smc_key_info(smc, ss->ss_key, &ss->ss_len,
+			    ss->ss_type, &flags);
+		else if (ret == 0)
+			ret = ENOENT;
+		mutex_exit(&smc->smc_lock);
+		if (ret == EIO && ++errors >= SMC_MAX_ERRORS) {
+			dev_err(smc->smc_dip, CE_WARN, "SMC stopped answering "
+			    "at key %u, sensor scan aborted", i);
+			break;
+		}
+		if (ret != 0)
+			continue;
+
+		if (!((bcmp(ss->ss_type, "sp78", 4) == 0 && ss->ss_len == 2) ||
+		    (bcmp(ss->ss_type, "flt ", 4) == 0 && ss->ss_len == 4)))
+			continue;
+
+		ss->ss_smc = smc;
+		if (smc_temp_q8(smc, ss, &q8) != 0 || q8 <= 0 ||
+		    q8 >= 150 * 256)
+			continue;
+
+		for (j = 0; j < APPLESMC_KEYLEN; j++) {
+			char c = ss->ss_key[j];
+			name[j] = ((c >= '0' && c <= '9') ||
+			    (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')) ?
+			    c : '_';
+		}
+		name[APPLESMC_KEYLEN] = '\0';
+
+		if (ksensor_create(smc->smc_dip, &smc_temp_ops, ss, name,
+		    "ddi_sensor:temperature:smc", &ss->ss_id) != 0) {
+			dev_err(smc->smc_dip, CE_WARN, "!failed to create "
+			    "sensor %s", name);
+			continue;
+		}
+		smc->smc_nsensors++;
+	}
+}
+
+/*
+ * ACPI: find APP0001 and the start of its first I/O port range.
+ */
+static ACPI_STATUS
+smc_crs_cb(ACPI_RESOURCE *res, void *ctx)
+{
+	uint16_t *basep = ctx;
+
+	if (res->Type == ACPI_RESOURCE_TYPE_IO && *basep == 0) {
+		*basep = res->Data.Io.Minimum;
+		return (AE_CTRL_TERMINATE);
+	}
+	if (res->Type == ACPI_RESOURCE_TYPE_FIXED_IO && *basep == 0) {
+		*basep = res->Data.FixedIo.Address;
+		return (AE_CTRL_TERMINATE);
+	}
+	return (AE_OK);
+}
+
+static ACPI_STATUS
+smc_find_cb(ACPI_HANDLE hdl, UINT32 lvl, void *ctx, void **rv)
+{
+	_NOTE(ARGUNUSED(lvl, rv));
+	*(ACPI_HANDLE *)ctx = hdl;
+	return (AE_CTRL_TERMINATE);
+}
+
+static boolean_t
+smc_find(uint16_t *basep)
+{
+	ACPI_HANDLE hdl = NULL;
+
+	if (AcpiSubsystemStatus() != AE_OK)
+		return (B_FALSE);
+	if (ACPI_FAILURE(AcpiGetDevices("APP0001", smc_find_cb, &hdl, NULL)) ||
+	    hdl == NULL)
+		return (B_FALSE);
+
+	*basep = 0;
+	(void) AcpiWalkResources(hdl, "_CRS", smc_crs_cb, basep);
+	if (*basep == 0)
+		*basep = SMC_DEFAULT_BASE;
+	return (B_TRUE);
+}
+
+static int
+applesmc_open(dev_t *devp, int flag, int otyp, cred_t *cr)
+{
+	_NOTE(ARGUNUSED(cr));
+
+	if (applesmc == NULL || getminor(*devp) != 0)
+		return (ENXIO);
+	if (otyp != OTYP_CHR)
+		return (EINVAL);
+	/* Read only: nothing here ever writes an SMC key. */
+	if (flag & FWRITE)
+		return (EPERM);
+	return (0);
+}
+
+static int
+applesmc_close(dev_t dev, int flag, int otyp, cred_t *cr)
+{
+	_NOTE(ARGUNUSED(dev, flag, otyp, cr));
+	return (0);
+}
+
+static int
+applesmc_ioctl(dev_t dev, int cmd, intptr_t arg, int mode, cred_t *cr,
+    int *rvalp)
+{
+	applesmc_t *smc = applesmc;
+	applesmc_key_t ak;
+	int ret = 0;
+
+	_NOTE(ARGUNUSED(dev, cr, rvalp));
+
+	if (smc == NULL)
+		return (ENXIO);
+
+	if (cmd == APPLESMC_IOC_NKEYS) {
+		if (ddi_copyout(&smc->smc_nkeys, (void *)arg,
+		    sizeof (uint32_t), mode & FKIOCTL) != 0)
+			return (EFAULT);
+		return (0);
+	}
+
+	if (cmd != APPLESMC_IOC_KEYBYIDX && cmd != APPLESMC_IOC_KEYINFO &&
+	    cmd != APPLESMC_IOC_READ)
+		return (ENOTTY);
+
+	if (ddi_copyin((void *)arg, &ak, sizeof (ak), mode & FKIOCTL) != 0)
+		return (EFAULT);
+
+	mutex_enter(&smc->smc_lock);
+	switch (cmd) {
+	case APPLESMC_IOC_KEYBYIDX:
+		if (ak.ak_index >= smc->smc_nkeys) {
+			ret = EINVAL;
+			break;
+		}
+		ret = smc_key_by_index(smc, ak.ak_index, ak.ak_key);
+		break;
+	case APPLESMC_IOC_KEYINFO:
+	case APPLESMC_IOC_READ:
+		if (!smc_key_ok(ak.ak_key)) {
+			ret = EINVAL;
+			break;
+		}
+		ret = smc_key_info(smc, ak.ak_key, &ak.ak_len, ak.ak_type,
+		    &ak.ak_flags);
+		if (ret != 0 || cmd == APPLESMC_IOC_KEYINFO)
+			break;
+		if (ak.ak_len == 0 || ak.ak_len > APPLESMC_MAXDATA) {
+			ret = EOVERFLOW;
+			break;
+		}
+		bzero(ak.ak_data, sizeof (ak.ak_data));
+		ret = smc_read_key(smc, ak.ak_key, ak.ak_data, ak.ak_len);
+		break;
+	}
+	mutex_exit(&smc->smc_lock);
+
+	if (ret == 0 && ddi_copyout(&ak, (void *)arg, sizeof (ak),
+	    mode & FKIOCTL) != 0)
+		ret = EFAULT;
+	return (ret);
+}
+
+static int
+applesmc_getinfo(dev_info_t *dip, ddi_info_cmd_t cmd, void *arg, void **res)
+{
+	_NOTE(ARGUNUSED(dip, arg));
+
+	switch (cmd) {
+	case DDI_INFO_DEVT2DEVINFO:
+		if (applesmc == NULL)
+			return (DDI_FAILURE);
+		*res = applesmc->smc_dip;
+		return (DDI_SUCCESS);
+	case DDI_INFO_DEVT2INSTANCE:
+		*res = (void *)0;
+		return (DDI_SUCCESS);
+	default:
+		return (DDI_FAILURE);
+	}
+}
+
+static void
+applesmc_cleanup(applesmc_t *smc)
+{
+	(void) ksensor_remove(smc->smc_dip, KSENSOR_ALL_IDS);
+	ddi_remove_minor_node(smc->smc_dip, NULL);
+	mutex_destroy(&smc->smc_lock);
+	kmem_free(smc, sizeof (*smc));
+}
+
+static int
+applesmc_attach(dev_info_t *dip, ddi_attach_cmd_t cmd)
+{
+	applesmc_t *smc;
+	uint16_t base;
+	uint8_t be[4];
+
+	switch (cmd) {
+	case DDI_RESUME:
+		return (DDI_SUCCESS);
+	case DDI_ATTACH:
+		break;
+	default:
+		return (DDI_FAILURE);
+	}
+
+	if (ddi_get_instance(dip) != 0 || applesmc != NULL)
+		return (DDI_FAILURE);
+	if (!smc_find(&base))
+		return (DDI_FAILURE);
+
+	smc = kmem_zalloc(sizeof (*smc), KM_SLEEP);
+	smc->smc_dip = dip;
+	smc->smc_base = base;
+	mutex_init(&smc->smc_lock, NULL, MUTEX_DRIVER, NULL);
+
+	mutex_enter(&smc->smc_lock);
+	if (smc_read_key(smc, "#KEY", be, sizeof (be)) != 0) {
+		mutex_exit(&smc->smc_lock);
+		dev_err(dip, CE_WARN, "SMC at 0x%x does not answer", base);
+		applesmc_cleanup(smc);
+		return (DDI_FAILURE);
+	}
+	mutex_exit(&smc->smc_lock);
+	smc->smc_nkeys = ((uint32_t)be[0] << 24) | (be[1] << 16) |
+	    (be[2] << 8) | be[3];
+
+	if (ddi_create_minor_node(dip, "applesmc", S_IFCHR, 0, DDI_PSEUDO,
+	    0) != DDI_SUCCESS) {
+		dev_err(dip, CE_WARN, "failed to create minor node");
+		applesmc_cleanup(smc);
+		return (DDI_FAILURE);
+	}
+
+	smc_create_sensors(smc);
+	applesmc = smc;
+	ddi_report_dev(dip);
+	dev_err(dip, CE_CONT, "?SMC at 0x%x: %u keys, %u temperature "
+	    "sensors\n", base, smc->smc_nkeys, smc->smc_nsensors);
+	return (DDI_SUCCESS);
+}
+
+static int
+applesmc_detach(dev_info_t *dip, ddi_detach_cmd_t cmd)
+{
+	applesmc_t *smc = applesmc;
+
+	switch (cmd) {
+	case DDI_SUSPEND:
+		return (DDI_SUCCESS);
+	case DDI_DETACH:
+		break;
+	default:
+		return (DDI_FAILURE);
+	}
+
+	if (smc == NULL || smc->smc_dip != dip)
+		return (DDI_FAILURE);
+	applesmc = NULL;
+	applesmc_cleanup(smc);
+	return (DDI_SUCCESS);
+}
+
+static struct cb_ops applesmc_cb_ops = {
+	.cb_open = applesmc_open,
+	.cb_close = applesmc_close,
+	.cb_strategy = nodev,
+	.cb_print = nodev,
+	.cb_dump = nodev,
+	.cb_read = nodev,
+	.cb_write = nodev,
+	.cb_ioctl = applesmc_ioctl,
+	.cb_devmap = nodev,
+	.cb_mmap = nodev,
+	.cb_segmap = nodev,
+	.cb_chpoll = nochpoll,
+	.cb_prop_op = ddi_prop_op,
+	.cb_flag = D_MP,
+	.cb_rev = CB_REV,
+	.cb_aread = nodev,
+	.cb_awrite = nodev
+};
+
+static struct dev_ops applesmc_dev_ops = {
+	.devo_rev = DEVO_REV,
+	.devo_refcnt = 0,
+	.devo_getinfo = applesmc_getinfo,
+	.devo_identify = nulldev,
+	.devo_probe = nulldev,
+	.devo_attach = applesmc_attach,
+	.devo_detach = applesmc_detach,
+	.devo_reset = nodev,
+	.devo_cb_ops = &applesmc_cb_ops,
+	.devo_power = NULL,
+	.devo_quiesce = ddi_quiesce_not_needed
+};
+
+static struct modldrv applesmc_modldrv = {
+	.drv_modops = &mod_driverops,
+	.drv_linkinfo = "Apple SMC sensors",
+	.drv_dev_ops = &applesmc_dev_ops
+};
+
+static struct modlinkage applesmc_modlinkage = {
+	.ml_rev = MODREV_1,
+	.ml_linkage = { &applesmc_modldrv, NULL }
+};
+
+int
+_init(void)
+{
+	return (mod_install(&applesmc_modlinkage));
+}
+
+int
+_info(struct modinfo *modinfop)
+{
+	return (mod_info(&applesmc_modlinkage, modinfop));
+}
+
+int
+_fini(void)
+{
+	return (mod_remove(&applesmc_modlinkage));
+}
