diff --git a/usr/src/cmd/smcstat/smcstat.c b/usr/src/cmd/smcstat/smcstat.c
new file mode 100644
index 00000000..eb5e194f
--- /dev/null
+++ b/usr/src/cmd/smcstat/smcstat.c
@@ -0,0 +1,388 @@
+/*
+ * This file and its contents are supplied under the terms of the
+ * Common Development and Distribution License ("CDDL"), version 1.0.
+ * You may only use this file in accordance with the terms of version
+ * 1.0 of the CDDL.
+ *
+ * A full copy of the text of the CDDL should have accompanied this
+ * source.  A copy of the CDDL is also available via the Internet at
+ * http://www.illumos.org/license/CDDL.
+ */
+
+/*
+ * Copyright 2026 isoriano1968
+ */
+
+/*
+ * smcstat: show the temperatures and fans of an Intel Mac from its SMC,
+ * through applesmc(4D).
+ *
+ *	smcstat			temperatures and fans
+ *	smcstat -i secs		repeat every secs seconds
+ *	smcstat -p		parsable: key:type:value lines
+ *	smcstat -a		every key, decoded where the type is known
+ *	smcstat KEY ...		just these keys
+ */
+
+#include <sys/types.h>
+#include <sys/applesmc.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+#include <err.h>
+#include <errno.h>
+
+static int smcfd = -1;
+static int pflag;
+
+static const struct {
+	const char *k;
+	const char *desc;
+} names[] = {
+	{ "TA0P", "ambient" },
+	{ "TA0p", "ambient" },
+	{ "TA1P", "ambient 2" },
+	{ "TC0P", "CPU proximity" },
+	{ "TC0p", "CPU proximity" },
+	{ "TC0D", "CPU die" },
+	{ "TC0E", "CPU die (virtual)" },
+	{ "TC0F", "CPU die (filtered)" },
+	{ "TC0H", "CPU heatsink" },
+	{ "TCXC", "CPU PECI" },
+	{ "TCXc", "CPU PECI" },
+	{ "TC1C", "CPU core 1" },
+	{ "TC2C", "CPU core 2" },
+	{ "TC3C", "CPU core 3" },
+	{ "TC4C", "CPU core 4" },
+	{ "TC5C", "CPU core 5" },
+	{ "TC6C", "CPU core 6" },
+	{ "TC7C", "CPU core 7" },
+	{ "TC8C", "CPU core 8" },
+	{ "TG0D", "GPU 0 die" },
+	{ "TG0P", "GPU 0 proximity" },
+	{ "TG0p", "GPU 0 proximity" },
+	{ "TG0H", "GPU 0 heatsink" },
+	{ "TG1D", "GPU 1 die" },
+	{ "TG1P", "GPU 1 proximity" },
+	{ "TG1p", "GPU 1 proximity" },
+	{ "TG1H", "GPU 1 heatsink" },
+	{ "TH0P", "drive proximity" },
+	{ "TH0p", "drive proximity" },
+	{ "TH0F", "drive (filtered)" },
+	{ "TI0P", "Thunderbolt 0" },
+	{ "TI1P", "Thunderbolt 1" },
+	{ "TM0P", "memory proximity" },
+	{ "TM0p", "memory proximity" },
+	{ "TM0S", "memory slot" },
+	{ "TN0P", "northbridge proximity" },
+	{ "TN0D", "northbridge die" },
+	{ "TPCD", "PCH die" },
+	{ "TPCd", "PCH die" },
+	{ "Tp0C", "power supply" },
+	{ "Tp0P", "power supply proximity" },
+	{ "TL0P", "LCD proximity" },
+	{ "TO0P", "optical drive" },
+	{ "TW0P", "wireless proximity" },
+	{ NULL, NULL }
+};
+
+static const char *
+keydesc(const char *k)
+{
+	int i;
+
+	for (i = 0; names[i].k != NULL; i++) {
+		if (strncmp(names[i].k, k, 4) == 0)
+			return (names[i].desc);
+	}
+	return ("");
+}
+
+static int
+smc_read(const char *key, applesmc_key_t *ak)
+{
+	bzero(ak, sizeof (*ak));
+	(void) memcpy(ak->ak_key, key, APPLESMC_KEYLEN);
+	return (ioctl(smcfd, APPLESMC_IOC_READ, ak));
+}
+
+/*
+ * Decode a numeric SMC value; returns 0 and sets *v on success.
+ */
+static int
+decode(const applesmc_key_t *ak, double *v)
+{
+	const uint8_t *d = ak->ak_data;
+	const char *t = ak->ak_type;
+	float f;
+
+	if (strncmp(t, "flt ", 4) == 0 && ak->ak_len == 4) {
+		(void) memcpy(&f, d, 4);	/* little endian, as x86 */
+		*v = f;
+	} else if (strncmp(t, "sp78", 4) == 0 && ak->ak_len == 2) {
+		*v = (int16_t)((d[0] << 8) | d[1]) / 256.0;
+	} else if (strncmp(t, "sp87", 4) == 0 && ak->ak_len == 2) {
+		*v = (int16_t)((d[0] << 8) | d[1]) / 128.0;
+	} else if (strncmp(t, "sp96", 4) == 0 && ak->ak_len == 2) {
+		*v = (int16_t)((d[0] << 8) | d[1]) / 64.0;
+	} else if (strncmp(t, "sp5a", 4) == 0 && ak->ak_len == 2) {
+		*v = (int16_t)((d[0] << 8) | d[1]) / 1024.0;
+	} else if (strncmp(t, "fpe2", 4) == 0 && ak->ak_len == 2) {
+		*v = ((d[0] << 8) | d[1]) / 4.0;
+	} else if (strncmp(t, "fp88", 4) == 0 && ak->ak_len == 2) {
+		*v = ((d[0] << 8) | d[1]) / 256.0;
+	} else if (strncmp(t, "fpc4", 4) == 0 && ak->ak_len == 2) {
+		*v = ((d[0] << 8) | d[1]) / 16.0;
+	} else if (strncmp(t, "ui8 ", 4) == 0 && ak->ak_len == 1) {
+		*v = d[0];
+	} else if (strncmp(t, "ui16", 4) == 0 && ak->ak_len == 2) {
+		*v = (d[0] << 8) | d[1];
+	} else if (strncmp(t, "ui32", 4) == 0 && ak->ak_len == 4) {
+		*v = ((uint32_t)d[0] << 24) | (d[1] << 16) | (d[2] << 8) | d[3];
+	} else if (strncmp(t, "si8 ", 4) == 0 && ak->ak_len == 1) {
+		*v = (int8_t)d[0];
+	} else if (strncmp(t, "si16", 4) == 0 && ak->ak_len == 2) {
+		*v = (int16_t)((d[0] << 8) | d[1]);
+	} else if (strncmp(t, "flag", 4) == 0 && ak->ak_len == 1) {
+		*v = d[0];
+	} else {
+		return (-1);
+	}
+	return (0);
+}
+
+static void
+print_raw(const applesmc_key_t *ak)
+{
+	int i;
+
+	for (i = 0; i < ak->ak_len; i++)
+		(void) printf("%02x", ak->ak_data[i]);
+}
+
+static void
+show_key(const char *key)
+{
+	applesmc_key_t ak;
+	double v;
+
+	if (smc_read(key, &ak) != 0) {
+		warn("%.4s", key);
+		return;
+	}
+	if (pflag) {
+		(void) printf("%.4s:%.4s:", ak.ak_key, ak.ak_type);
+		if (decode(&ak, &v) == 0)
+			(void) printf("%g\n", v);
+		else {
+			print_raw(&ak);
+			(void) printf("\n");
+		}
+		return;
+	}
+	(void) printf("%.4s  %.4s  %2u  ", ak.ak_key, ak.ak_type, ak.ak_len);
+	if (decode(&ak, &v) == 0)
+		(void) printf("%12.2f", v);
+	else {
+		(void) printf("  ");
+		print_raw(&ak);
+	}
+	(void) printf("\n");
+}
+
+static uint32_t
+nkeys(void)
+{
+	uint32_t n;
+
+	if (ioctl(smcfd, APPLESMC_IOC_NKEYS, &n) != 0)
+		err(EXIT_FAILURE, "APPLESMC_IOC_NKEYS");
+	return (n);
+}
+
+static int
+key_at(uint32_t i, char *key)
+{
+	applesmc_key_t ak;
+
+	bzero(&ak, sizeof (ak));
+	ak.ak_index = i;
+	if (ioctl(smcfd, APPLESMC_IOC_KEYBYIDX, &ak) != 0)
+		return (-1);
+	(void) memcpy(key, ak.ak_key, 4);
+	return (0);
+}
+
+static void
+show_all(void)
+{
+	uint32_t i, n = nkeys();
+	char key[4];
+
+	for (i = 0; i < n; i++) {
+		if (key_at(i, key) == 0)
+			show_key(key);
+	}
+}
+
+static void
+show_temps(void)
+{
+	uint32_t i, n = nkeys();
+	applesmc_key_t ak;
+	char key[4];
+	double v;
+
+	if (!pflag)
+		(void) printf("%-4s  %8s  %s\n", "KEY", "CELSIUS", "SENSOR");
+	for (i = 0; i < n; i++) {
+		if (key_at(i, key) != 0 || key[0] != 'T')
+			continue;
+		if (smc_read(key, &ak) != 0 || decode(&ak, &v) != 0)
+			continue;
+		if (strncmp(ak.ak_type, "sp78", 4) != 0 &&
+		    strncmp(ak.ak_type, "flt ", 4) != 0)
+			continue;
+		if (v <= 0.0 || v >= 150.0)	/* not populated */
+			continue;
+		if (pflag)
+			(void) printf("temp:%.4s:%.2f\n", key, v);
+		else
+			(void) printf("%.4s  %8.2f  %s\n", key, v,
+			    keydesc(key));
+	}
+}
+
+/*
+ * Fan keys are F<n>.., n a single digit (show_fans stops at 10 fans).
+ */
+static int
+fan_value(int fan, char what, double *v)
+{
+	char key[5];
+	applesmc_key_t ak;
+
+	(void) snprintf(key, sizeof (key), "F%c%c%c", '0' + fan, what,
+	    what == 'A' ? 'c' : what == 'M' ? 'n' : 'g');
+	if (smc_read(key, &ak) != 0)
+		return (-1);
+	return (decode(&ak, v));
+}
+
+static int
+fan_named(int fan, const char *suffix, double *v)
+{
+	char key[5];
+	applesmc_key_t ak;
+
+	(void) snprintf(key, sizeof (key), "F%c%.2s", '0' + fan, suffix);
+	if (smc_read(key, &ak) != 0)
+		return (-1);
+	return (decode(&ak, v));
+}
+
+static void
+show_fans(void)
+{
+	applesmc_key_t ak;
+	double cur, mn, mx, tg;
+	int nfans, i;
+
+	if (smc_read("FNum", &ak) != 0 || ak.ak_len < 1) {
+		if (!pflag)
+			(void) printf("no fans reported\n");
+		return;
+	}
+	nfans = ak.ak_data[0];
+	if (!pflag)
+		(void) printf("\n%-4s  %8s  %8s  %8s  %8s  %s\n", "FAN", "RPM",
+		    "TARGET", "MIN", "MAX", "NAME");
+	for (i = 0; i < nfans && i < 10; i++) {
+		char idk[5], name[17] = "";
+
+		if (fan_value(i, 'A', &cur) != 0)
+			continue;
+		if (fan_named(i, "Mn", &mn) != 0)
+			mn = -1;
+		if (fan_named(i, "Mx", &mx) != 0)
+			mx = -1;
+		if (fan_named(i, "Tg", &tg) != 0)
+			tg = -1;
+		(void) snprintf(idk, sizeof (idk), "F%cID", '0' + i);
+		if (smc_read(idk, &ak) == 0 && ak.ak_len >= 16) {
+			/* {type, zone, location, pad, char name[12]} */
+			(void) memcpy(name, &ak.ak_data[4], 12);
+			name[12] = '\0';
+		}
+		if (pflag)
+			(void) printf("fan:%d:%.0f:%.0f:%.0f:%.0f:%s\n", i, cur,
+			    tg, mn, mx, name);
+		else
+			(void) printf("F%d    %8.0f  %8.0f  %8.0f  %8.0f  %s\n",
+			    i, cur, tg, mn, mx, name);
+	}
+}
+
+static void
+usage(void)
+{
+	(void) fprintf(stderr, "usage: smcstat [-ap] [-i secs] [KEY ...]\n");
+	exit(2);
+}
+
+int
+main(int argc, char **argv)
+{
+	int c, aflag = 0, interval = 0;
+
+	while ((c = getopt(argc, argv, "api:")) != -1) {
+		switch (c) {
+		case 'a':
+			aflag = 1;
+			break;
+		case 'p':
+			pflag = 1;
+			break;
+		case 'i':
+			interval = atoi(optarg);
+			if (interval <= 0)
+				usage();
+			break;
+		default:
+			usage();
+		}
+	}
+	argc -= optind;
+	argv += optind;
+
+	if ((smcfd = open("/dev/applesmc", O_RDONLY)) < 0)
+		err(EXIT_FAILURE, "/dev/applesmc");
+
+	for (;;) {
+		if (argc > 0) {
+			int i;
+
+			for (i = 0; i < argc; i++) {
+				if (strlen(argv[i]) != 4)
+					errx(2, "%s: keys have 4 characters",
+					    argv[i]);
+				show_key(argv[i]);
+			}
+		} else if (aflag) {
+			show_all();
+		} else {
+			show_temps();
+			show_fans();
+		}
+		if (interval == 0)
+			break;
+		(void) fflush(stdout);
+		(void) sleep(interval);
+		if (!pflag)
+			(void) printf("\n");
+	}
+	return (0);
+}
