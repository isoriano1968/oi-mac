@@ -0,0 +1,59 @@
+/*
+ * This file and its contents are supplied under the terms of the
+ * Common Development and Distribution License ("CDDL"), version 1.0.
+ * You may only use this file in accordance with the terms of version
+ * 1.0 of the CDDL.
+ *
+ * A full copy of the text of the CDDL should have accompanied this
+ * source.  A copy of the CDDL is also available via the Internet at
+ * http://www.illumos.org/license/CDDL.
+ */
+
+/*
+ * Copyright 2026 isoriano1968
+ */
+
+#ifndef _SYS_APPLESMC_H
+#define	_SYS_APPLESMC_H
+
+/*
+ * Read-only interface to the Apple System Management Controller (SMC) of
+ * Intel Macs, through /dev/applesmc. The SMC holds temperatures, fan speeds,
+ * voltages, currents and power values as four-character keys ("TC0P",
+ * "F0Ac"); each key has a length, a four-character type ("sp78", "fpe2",
+ * "flt ", "ui8 ", ...) and flags. Values are returned raw, as the SMC sends
+ * them; decoding by type is left to the consumer.
+ *
+ * This interface is private and may change.
+ */
+
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define	APPLESMC_IOC		(('s' << 24) | ('m' << 16) | ('c' << 8))
+#define	APPLESMC_IOC_NKEYS	(APPLESMC_IOC | 0x01)	/* uint32_t */
+#define	APPLESMC_IOC_KEYBYIDX	(APPLESMC_IOC | 0x02)	/* applesmc_key_t */
+#define	APPLESMC_IOC_KEYINFO	(APPLESMC_IOC | 0x03)	/* applesmc_key_t */
+#define	APPLESMC_IOC_READ	(APPLESMC_IOC | 0x04)	/* applesmc_key_t */
+
+#define	APPLESMC_KEYLEN		4
+#define	APPLESMC_MAXDATA	32
+
+typedef struct applesmc_key {
+	uint32_t	ak_index;	/* in: KEYBYIDX */
+	char		ak_key[APPLESMC_KEYLEN];	/* in; out: KEYBYIDX */
+	char		ak_type[APPLESMC_KEYLEN];	/* out: KEYINFO, READ */
+	uint8_t		ak_len;		/* out: KEYINFO, READ */
+	uint8_t		ak_flags;	/* out: KEYINFO, READ */
+	uint8_t		ak_pad[2];
+	uint8_t		ak_data[APPLESMC_MAXDATA];	/* out: READ */
+} applesmc_key_t;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _SYS_APPLESMC_H */
