diff --git b/usr/src/cmd/smcfan/smcfan.c b/usr/src/cmd/smcfan/smcfan.c
new file mode 100644
index 0000000..a1a243c
--- /dev/null
+++ b/usr/src/cmd/smcfan/smcfan.c
@@ -0,0 +1,345 @@
+/*
+ * This file and its contents are supplied under the terms of the
+ * Common Development and Distribution License ("CDDL"), version 1.0.
+ * You may only use this file in accordance with the terms of version
+ * 1.0 of the CDDL.
+ *
+ * A full copy of the text of the CDDL should have accompanied this
+ * source.  A copy of the CDDL is also available via the Internet at
+ * http://www.illumos.org/license/CDDL.
+ */
+
+/*
+ * Copyright 2026 isoriano1968
+ */
+
+/*
+ * smcfan: fan presets for the Apple SMC, through applesmc(4D).
+ *
+ *	smcfan			list the fans and the active preset
+ *	smcfan -s preset	auto, cool, cooler or max, for every fan
+ *	smcfan -m rpm		an explicit minimum, for every fan
+ *	smcfan -p -s preset	also keep it in svc:/system/applesmc-fan
+ *
+ * A preset only raises the floor (F<n>Mn) the SMC keeps the fan above; the
+ * SMC keeps controlling the fan above it, with its own protection.
+ */
+
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <sys/applesmc.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+#include <spawn.h>
+#include <err.h>
+#include <errno.h>
+
+#define	EXIT_USAGE	2
+#define	EXIT_NOTSUP	3	/* no SMC, or a driver without fan control */
+#define	EXIT_PERM	4	/* not privileged */
+
+#define	SMCDEV		"/dev/applesmc"
+#define	SVC		"svc:/system/applesmc-fan"	/* has config/preset */
+#define	FMRI		SVC ":default"
+#define	MAXFANS		10
+
+extern char **environ;
+
+static const char *presets[] = { "auto", "cool", "cooler", "max", NULL };
+
+typedef struct fan {
+	int		f_n;
+	uint16_t	f_act, f_tg, f_mn;	/* fpe2 raw: rpm * 4 */
+	uint16_t	f_orig, f_max;		/* from APPLESMC_IOC_FANMIN */
+	boolean_t	f_hastg;
+} fan_t;
+
+static int smcfd = -1;
+static fan_t fans[MAXFANS];
+static int nfans;
+
+static uint16_t
+be16(const uint8_t *b)
+{
+	return ((uint16_t)((b[0] << 8) | b[1]));
+}
+
+static void
+smc_open(int flags)
+{
+	if ((smcfd = open(SMCDEV, flags)) >= 0)
+		return;
+	if (errno == ENOENT || errno == ENXIO)
+		errx(EXIT_NOTSUP, "%s: %s (no Apple SMC, or applesmc(4D) is "
+		    "not loaded)", SMCDEV, strerror(errno));
+	if (errno == EACCES || errno == EPERM)
+		errx(EXIT_PERM, "%s: %s (changing the fans needs the "
+		    "\"Apple SMC Fan Control\" rights profile: pfexec smcfan)",
+		    SMCDEV, strerror(errno));
+	err(EXIT_FAILURE, "%s", SMCDEV);
+}
+
+static int
+smc_ioc(int cmd, const char *key, applesmc_key_t *ak)
+{
+	bzero(ak, sizeof (*ak));
+	(void) memcpy(ak->ak_key, key, APPLESMC_KEYLEN);
+	return (ioctl(smcfd, cmd, ak));
+}
+
+/* Fan keys are F<n>.., n a single digit. */
+static void
+fan_keyname(char key[5], int n, const char *what)
+{
+	key[0] = 'F';
+	key[1] = '0' + n;
+	key[2] = what[0];
+	key[3] = what[1];
+	key[4] = '\0';
+}
+
+static int
+fan_key(int n, const char *what, uint16_t *v)
+{
+	char key[5];
+	applesmc_key_t ak;
+
+	fan_keyname(key, n, what);
+	if (smc_ioc(APPLESMC_IOC_READ, key, &ak) != 0)
+		return (-1);
+	if (strncmp(ak.ak_type, "fpe2", 4) != 0 || ak.ak_len != 2)
+		return (-1);
+	*v = be16(ak.ak_data);
+	return (0);
+}
+
+static void
+load_fans(void)
+{
+	applesmc_key_t ak;
+	int i, n;
+
+	if (smc_ioc(APPLESMC_IOC_READ, "FNum", &ak) != 0 || ak.ak_len < 1)
+		errx(EXIT_NOTSUP, "the SMC reports no fans");
+	n = ak.ak_data[0];
+	for (i = 0; i < n && i < MAXFANS; i++) {
+		char key[5];
+		fan_t *f = &fans[nfans];
+
+		bzero(f, sizeof (*f));
+		f->f_n = i;
+		fan_keyname(key, i, "Mn");
+		if (smc_ioc(APPLESMC_IOC_FANMIN, key, &ak) != 0) {
+			if (errno == ENOTTY || errno == EINVAL)
+				errx(EXIT_NOTSUP, "this applesmc(4D) has no "
+				    "fan control");
+			continue;	/* not a fan the driver can set */
+		}
+		f->f_orig = be16(ak.ak_data);
+		f->f_max = be16(&ak.ak_data[2]);
+		if (fan_key(i, "Ac", &f->f_act) != 0 ||
+		    fan_key(i, "Mn", &f->f_mn) != 0)
+			continue;
+		f->f_hastg = fan_key(i, "Tg", &f->f_tg) == 0;
+		nfans++;
+	}
+	if (nfans == 0)
+		errx(EXIT_NOTSUP, "no fan the driver can set");
+}
+
+/* The floor a preset gives a fan, fpe2 raw. */
+static uint16_t
+preset_min(const fan_t *f, int p)
+{
+	uint32_t span = f->f_max - f->f_orig;
+
+	switch (p) {
+	case 0:
+		return (f->f_orig);
+	case 1:
+		return (f->f_orig + span / 3);
+	case 2:
+		return (f->f_orig + span * 2 / 3);
+	default:
+		return (f->f_max);
+	}
+}
+
+/* The preset every fan is at, or -1. */
+static int
+active_preset(void)
+{
+	int p, i;
+
+	for (p = 0; presets[p] != NULL; p++) {
+		for (i = 0; i < nfans; i++) {
+			int d = (int)fans[i].f_mn -
+			    (int)preset_min(&fans[i], p);
+
+			if (d < -4 || d > 4)	/* within 1 rpm */
+				break;
+		}
+		if (i == nfans)
+			return (p);
+	}
+	return (-1);
+}
+
+static void
+list(void)
+{
+	int i, p;
+
+	(void) printf("%-4s  %6s  %6s  %6s  %6s  %7s\n", "FAN", "RPM",
+	    "TARGET", "MIN", "MAX", "DEFAULT");
+	for (i = 0; i < nfans; i++) {
+		fan_t *f = &fans[i];
+
+		(void) printf("F%-3d  %6u  ", f->f_n, f->f_act / 4);
+		if (f->f_hastg)
+			(void) printf("%6u", f->f_tg / 4);
+		else
+			(void) printf("%6s", "-");
+		(void) printf("  %6u  %6u  %7u\n", f->f_mn / 4,
+		    f->f_max / 4, f->f_orig / 4);
+	}
+	if ((p = active_preset()) >= 0)
+		(void) printf("preset: %s\n", presets[p]);
+	else
+		(void) printf("preset: manual\n");
+}
+
+static int
+set_min(fan_t *f, uint16_t raw)
+{
+	applesmc_key_t ak;
+	char key[5];
+
+	fan_keyname(key, f->f_n, "Mn");
+	bzero(&ak, sizeof (ak));
+	(void) memcpy(ak.ak_key, key, APPLESMC_KEYLEN);
+	(void) memcpy(ak.ak_type, "fpe2", APPLESMC_KEYLEN);
+	ak.ak_len = 2;
+	ak.ak_data[0] = raw >> 8;
+	ak.ak_data[1] = raw & 0xff;
+	if (ioctl(smcfd, APPLESMC_IOC_WRITE, &ak) != 0) {
+		if (errno == EPERM || errno == EACCES)
+			errx(EXIT_PERM, "%s: %s (needs the \"Apple SMC Fan "
+			    "Control\" rights profile: pfexec smcfan)", key,
+			    strerror(errno));
+		warn("%s", key);
+		return (-1);
+	}
+	f->f_mn = be16(ak.ak_data);
+	if (f->f_mn != raw)
+		warnx("%s: %u rpm is outside %u-%u, set to %u rpm", key,
+		    raw / 4, f->f_orig / 4, f->f_max / 4, f->f_mn / 4);
+	return (0);
+}
+
+static int
+run(char *const argv[])
+{
+	pid_t pid;
+	int st, e;
+
+	if ((e = posix_spawn(&pid, argv[0], NULL, NULL, argv, environ)) != 0) {
+		warnc(e, "%s", argv[0]);
+		return (-1);
+	}
+	if (waitpid(pid, &st, 0) < 0 || !WIFEXITED(st) ||
+	    WEXITSTATUS(st) != 0) {
+		warnx("%s %s failed", argv[0], argv[1]);
+		return (-1);
+	}
+	return (0);
+}
+
+/* Keep the preset in the service, which applies it at boot. */
+static int
+persist(const char *preset)
+{
+	char val[32];
+	char *setprop[] = { "/usr/sbin/svccfg", "-s", SVC, "setprop",
+	    "config/preset", "=", "astring:", val, NULL };
+	char *refresh[] = { "/usr/sbin/svcadm", "refresh", FMRI, NULL };
+	char *enable[] = { "/usr/sbin/svcadm", "enable", FMRI, NULL };
+
+	(void) snprintf(val, sizeof (val), "%s", preset);
+	if (run(setprop) != 0 || run(refresh) != 0 || run(enable) != 0)
+		return (-1);
+	return (0);
+}
+
+static void
+usage(void)
+{
+	(void) fprintf(stderr, "usage: smcfan\n"
+	    "       smcfan [-p] -s auto|cool|cooler|max\n"
+	    "       smcfan -m rpm\n");
+	exit(EXIT_USAGE);
+}
+
+int
+main(int argc, char **argv)
+{
+	const char *preset = NULL;
+	long rpm = -1;
+	int c, i, p = -1, pflag = 0, ret = 0;
+	char *end;
+
+	while ((c = getopt(argc, argv, "ps:m:")) != -1) {
+		switch (c) {
+		case 'p':
+			pflag = 1;
+			break;
+		case 's':
+			preset = optarg;
+			break;
+		case 'm':
+			errno = 0;
+			rpm = strtol(optarg, &end, 10);
+			if (errno != 0 || *end != '\0' || rpm < 0 ||
+			    rpm >= 0x4000)
+				errx(EXIT_USAGE, "%s: not a speed in rpm",
+				    optarg);
+			break;
+		default:
+			usage();
+		}
+	}
+	if (optind != argc || (preset != NULL && rpm >= 0) ||
+	    (pflag && preset == NULL))
+		usage();
+	if (preset != NULL) {
+		for (p = 0; presets[p] != NULL; p++) {
+			if (strcmp(presets[p], preset) == 0)
+				break;
+		}
+		if (presets[p] == NULL)
+			errx(EXIT_USAGE, "%s: not a preset (auto, cool, "
+			    "cooler, max)", preset);
+	}
+
+	smc_open(preset != NULL || rpm >= 0 ? O_RDWR : O_RDONLY);
+	load_fans();
+
+	if (preset == NULL && rpm < 0) {
+		list();
+		return (0);
+	}
+	for (i = 0; i < nfans; i++) {
+		uint16_t raw = preset != NULL ? preset_min(&fans[i], p) :
+		    (uint16_t)(rpm * 4);
+
+		if (set_min(&fans[i], raw) != 0)
+			ret = EXIT_FAILURE;
+	}
+	if (ret == 0 && pflag && persist(presets[p]) != 0)
+		ret = EXIT_FAILURE;
+	return (ret);
+}
diff --git b/usr/src/cmd/smcfan/svc-applesmc-fan b/usr/src/cmd/smcfan/svc-applesmc-fan
new file mode 100755
index 0000000..812c8db
--- /dev/null
+++ b/usr/src/cmd/smcfan/svc-applesmc-fan
@@ -0,0 +1,62 @@
+#!/sbin/sh
+#
+# This file and its contents are supplied under the terms of the
+# Common Development and Distribution License ("CDDL"), version 1.0.
+# You may only use this file in accordance with the terms of version
+# 1.0 of the CDDL.
+#
+# A full copy of the text of the CDDL should have accompanied this
+# source.  A copy of the CDDL is also available via the Internet at
+# http://www.illumos.org/license/CDDL.
+#
+
+#
+# Copyright 2026 isoriano1968
+#
+
+#
+# svc:/system/applesmc-fan: apply the fan preset config/preset with
+# smcfan(8) at boot and on refresh; give the fans back to the SMC's own
+# minimum (preset auto) on stop.
+#
+
+. /lib/svc/share/smf_include.sh
+
+case "$1" in
+start|refresh)
+	preset="${2:-auto}"
+	;;
+stop)
+	preset=auto
+	;;
+*)
+	echo "usage: $0 start|refresh|stop [preset]"
+	exit $SMF_EXIT_ERR_CONFIG
+	;;
+esac
+
+# Only a start method may disable the service temporarily.
+if [ ! -c /dev/applesmc ]; then
+	[ "$1" = start ] || exit $SMF_EXIT_OK
+	smf_method_exit $SMF_EXIT_TEMP_DISABLE \
+	    "no /dev/applesmc: not an Intel Mac, or applesmc(4D) not loaded"
+fi
+
+/usr/sbin/smcfan -s "$preset"
+case $? in
+0)
+	exit $SMF_EXIT_OK
+	;;
+2)
+	echo "config/preset: \"$preset\" is not auto, cool, cooler or max"
+	exit $SMF_EXIT_ERR_CONFIG
+	;;
+3)
