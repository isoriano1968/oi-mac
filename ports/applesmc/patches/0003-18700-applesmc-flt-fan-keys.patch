+/*
+ * "flt " (little-endian IEEE single, rpm) to rpm * 4, rounded down and
+ * limited to [0, 0xffff]; NaN, infinities and denormals give 0.
+ */
+static uint16_t
+smc_flt_get(const uint8_t *b)
+{
+	uint32_t bits = b[0] | (b[1] << 8) | (b[2] << 16) |
+	    ((uint32_t)b[3] << 24);
+	int exp = (bits >> 23) & 0xff;
+	uint32_t m = (bits & 0x7fffff) | 0x800000;
+	int shift;
+
+	if ((bits & 0x80000000U) != 0 || exp == 0 || exp == 0xff)
+		return (0);
+	/* value * 4 = m * 2^(exp - 150 + 2) */
+	shift = exp - 148;
+	if (shift >= 0)
+		return (shift > 0 ? 0xffff : (m > 0xffff ? 0xffff : m));
+	if (shift <= -24)
+		return (0);
+	m >>= -shift;
+	return (m > 0xffff ? 0xffff : (uint16_t)m);
+}
+
+/* rpm * 4 to "flt " (rpm); exact, since v has at most 16 bits. */
+static void
+smc_flt_put(uint8_t *b, uint16_t v)
+{
+	uint32_t bits = 0;
+	int h;
+
+	if (v != 0) {
+		for (h = 15; (v & (1U << h)) == 0; h--)
+			;
+		/* v / 4 = 1.f * 2^(h - 2) */
+		bits = ((uint32_t)(h - 2 + 127) << 23) |
+		    (((uint32_t)v << (23 - h)) & 0x7fffff);
+	}
+	b[0] = bits & 0xff;
+	b[1] = (bits >> 8) & 0xff;
+	b[2] = (bits >> 16) & 0xff;
+	b[3] = bits >> 24;
+}
+
+/* A fan value in the fan's own type: 2 (fpe2) or 4 ("flt ") bytes. */
+static uint16_t
+smc_fanval_get(const smc_fan_t *sf, const uint8_t *b)
+{
+	return (sf->sf_flt ? smc_flt_get(b) : smc_fpe2_get(b));
+}
+
+static uint8_t
+smc_fanval_put(const smc_fan_t *sf, uint8_t *b, uint16_t v)
+{
+	if (sf->sf_flt) {
+		smc_flt_put(b, v);
+		return (4);
+	}
+	smc_fpe2_put(b, v);
+	return (2);
+}
