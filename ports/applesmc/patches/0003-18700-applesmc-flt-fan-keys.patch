+	uint16_t	f_act, f_tg, f_mn;	/* rpm * 4 (the fpe2 scale) */
 	uint16_t	f_orig, f_max;		/* from APPLESMC_IOC_FANMIN */
 	boolean_t	f_hastg;
+	boolean_t	f_flt;			/* F<n>Mn is "flt ", not fpe2 */
 } fan_t;
 
 static int smcfd = -1;
@@ -102,18 +103,48 @@ fan_keyname(char key[5], int n, const char *what)
 	key[4] = '\0';
 }
 
+/*
+ * A fan value from the SMC's encoding to rpm * 4: fpe2 (14.2 fixed point,
+ * big endian, 2 bytes) or "flt " (IEEE single in rpm, little endian, 4
+ * bytes, the newer SMCs of the MacBook Pro 2016-2017 and later).
+ */
+static int
+fan_decode(const applesmc_key_t *ak, uint16_t *v, boolean_t *flt)
+{
+	if (strncmp(ak->ak_type, "fpe2", 4) == 0 && ak->ak_len == 2) {
+		*v = be16(ak->ak_data);
+		*flt = B_FALSE;
+		return (0);
+	}
+	if (strncmp(ak->ak_type, "flt ", 4) == 0 && ak->ak_len == 4) {
+		uint32_t bits = ak->ak_data[0] | (ak->ak_data[1] << 8) |
+		    (ak->ak_data[2] << 16) | ((uint32_t)ak->ak_data[3] << 24);
+		float f;
+
+		(void) memcpy(&f, &bits, sizeof (f));
+		if (!(f >= 0.0f))
+			f = 0.0f;
+		*v = f * 4.0f >= 65535.0f ? 0xffff : (uint16_t)(f * 4.0f);
+		*flt = B_TRUE;
+		return (0);
+	}
+	return (-1);
+}
