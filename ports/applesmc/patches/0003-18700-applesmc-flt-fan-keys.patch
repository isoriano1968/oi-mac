+
+		(void) memcpy(&bits, &rpm, sizeof (bits));
+		(void) memcpy(ak.ak_type, "flt ", APPLESMC_KEYLEN);
+		ak.ak_len = 4;
+		ak.ak_data[0] = bits & 0xff;
+		ak.ak_data[1] = (bits >> 8) & 0xff;
+		ak.ak_data[2] = (bits >> 16) & 0xff;
+		ak.ak_data[3] = bits >> 24;
+	} else {
+		(void) memcpy(ak.ak_type, "fpe2", APPLESMC_KEYLEN);
+		ak.ak_len = 2;
+		ak.ak_data[0] = raw >> 8;
+		ak.ak_data[1] = raw & 0xff;
+	}
 	if (ioctl(smcfd, APPLESMC_IOC_WRITE, &ak) != 0) {
 		if (errno == EPERM || errno == EACCES)
 			errx(EXIT_PERM, "%s: %s (needs the \"Apple SMC Fan "
@@ -234,7 +280,9 @@ set_min(fan_t *f, uint16_t raw)
 		warn("%s", key);
