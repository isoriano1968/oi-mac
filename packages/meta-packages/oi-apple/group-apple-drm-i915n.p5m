set name=pkg.fmri value=pkg:/group/apple/drm-i915n@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="OI-Apple: i915n (Intel Haswell..Kaby Lake graphics)"
set name=pkg.description value="illumos-drm with i915n and drmadm, e.g. for the iMac14,1."
set name=info.classification value="org.opensolaris.category.2008:$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
depend type=require fmri=pkg:/group/apple/gfx-stack
depend type=require fmri=pkg:/driver/graphics/drm-core
depend type=require fmri=pkg:/driver/graphics/linuxkpi
depend type=require fmri=pkg:/driver/graphics/drm-helpers
depend type=require fmri=pkg:/driver/graphics/drm-kms
depend type=require fmri=pkg:/driver/graphics/i915n
depend type=require fmri=pkg:/driver/graphics/drmadm
