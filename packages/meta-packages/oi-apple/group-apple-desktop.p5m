set name=pkg.fmri value=pkg:/group/apple/desktop@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="OI-Apple: desktop additions"
set name=pkg.description value="Mac Sensors, the Apple media keys for GNOME and the desktop caches service."
set name=info.classification value="org.opensolaris.category.2008:$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
depend type=require fmri=pkg:/desktop/system-monitor/mac-sensors@1.3
depend type=require fmri=pkg:/desktop/gnome/apple-media-keys
depend type=require fmri=pkg:/service/gnome/desktop-cache@0.2.2-2026.0.0.25
