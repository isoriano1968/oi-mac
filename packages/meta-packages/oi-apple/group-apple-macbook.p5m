set name=pkg.fmri value=pkg:/group/apple/macbook@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="OI-Apple: MacBook Pro keyboard, trackpad, Touch Bar and graphics switch"
set name=pkg.description value="atopcase (SPI keyboard and trackpad), appletb (Touch Bar) and applegmux (graphics multiplexer) for the MacBook Pro."
set name=info.classification value="org.opensolaris.category.2008:$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
depend type=require fmri=pkg:/driver/input/atopcase
depend type=require fmri=pkg:/driver/input/appletb
depend type=require fmri=pkg:/driver/graphics/applegmux
