# The GNOME keyring UI parts (gcr) and the dconf editor, and the X session
# tools beyond OI's live set (xrdb, xset, xrandr, xhost, xprop, xmodmap).
# Not the installers (gui-install, text-install, media/internal): the
# installer removes them from the installed system, which a require
# dependency here blocks; the media manifest lists them, as OI's slim_cd.

depend type=require fmri=pkg:/gnome/config/dconf/dconf-editor
depend type=require fmri=pkg:/library/gnome/gcr
depend type=require fmri=pkg:/x11/xhost
depend type=require fmri=pkg:/x11/xmodmap
depend type=require fmri=pkg:/x11/xprop
depend type=require fmri=pkg:/x11/xrandr
depend type=require fmri=pkg:/x11/xrdb
depend type=require fmri=pkg:/x11/xset
