set name=pkg.fmri value=pkg:/group/oi-mac/desktop_install@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="OI Mac: the live desktop package set"
set name=pkg.description value="Everything the OI Mac GNOME live media and the systems installed from them need: OpenIndiana's live desktop set (as mate_install, without MATE), GNOME with the OI Mac components, the installers and the X session tools."
set name=info.classification value="org.opensolaris.category.2008:$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

<include oi_live_base>
<include oi_mac_gnome>
<include oi_mac_live>
