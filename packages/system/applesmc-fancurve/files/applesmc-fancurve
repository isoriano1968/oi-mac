# applesmc-fancurve -- a temperature curve for the fans of an Intel Mac,
# on top of smcfan(8): every INTERVAL seconds the hottest memory, CPU, GPU and
# chipset sensors (smcstat's temperature table) give a fan floor between the SMC's own minimum
# and the maximum; smcfan -m sets it.  The SMC only ever raises the fan
# above that floor.  Up at once, down by at most STEP rpm per interval.
# Unreadable sensors: maximum.  On exit: back to the SMC (smcfan -s auto).
#
# Curves (start = minimum fan, full = maximum fan), in degrees C:
#   memory (hottest TM*)       65 .. 82
#   CPU    (hottest of TCXc/TCXC (PECI), TC0P/TC0E/TC0F/TC0D, TC<n>C cores)
#                              70 .. 88
#   GPU    (hottest TG?D die, TG?P proximity)  70 .. 88
#   chipset (TPCD)             72 .. 90
# Keys a model lacks are left out (MacBook Pros have no TM*/TCXc of the
# Mac Pro); with no memory and no CPU sensor at all the fans run at maximum.
#
# Several fans (MacBook Pro: two, with different ranges): one speed for
# all, between the lowest minimum and the highest maximum; the driver
# clamps each fan to its own range.
#
PATH=/usr/sbin:/usr/bin
INTERVAL=${INTERVAL:-5}
STEP=${STEP:-50}
LOG=${LOG:-}

restore() { smcfan -s auto >/dev/null 2>&1; exit 0; }
trap restore EXIT INT TERM HUP

# the SMC's own minimum (DEFAULT) and the maximum, from smcfan's listing:
# the lowest minimum and the highest maximum of all fans
read -r FMIN FMAX < <(smcfan | awk '$1 ~ /^F[0-9]+$/ {
	if (lo == "" || $6 < lo) lo = $6; if ($5 > hi) hi = $5 }
	END { if (lo != "") print lo, hi }')
[ -n "$FMIN" ] && [ -n "$FMAX" ] || { FMIN=790; FMAX=1900; }

cur=$FMAX
while :; do
	want=$(smcstat 2>/dev/null | awk -v lo="$FMIN" -v hi="$FMAX" '
	function lvl(t, a, b) { if (t <= a) return 0; if (t >= b) return 1; return (t - a) / (b - a) }
	$2 !~ /^[0-9.]+$/ { next }
	$1 ~ /^TM/ && $2 + 0 > mem + 0 { mem = $2 }
	$1 ~ /^TC(Xc|XC|0P|0E|0F|0D|[0-9]C)$/ && (cpu == "" || $2 + 0 > cpu + 0) { cpu = $2 }
	$1 ~ /^TG[0-9][DP]$/ && $2 + 0 > gpu + 0 { gpu = $2 }
	$1 == "TPCD" { pch = $2 }
	END {
		if (mem == "" && cpu == "") { print hi; exit }
		f = lvl(mem, 65, 82)
		if ((x = lvl(cpu, 70, 88)) > f) f = x
		if ((x = lvl(gpu, 70, 88)) > f) f = x
		if ((x = lvl(pch, 72, 90)) > f) f = x
		printf "%d %.1f %.1f %.1f %.1f\n", lo + f * (hi - lo), mem, cpu, gpu, pch
	}')
	set -- $want
	w=${1:-$FMAX}
	if [ "$w" -ge "$cur" ]; then cur=$w; else cur=$(( cur - STEP > w ? cur - STEP : w )); fi
	smcfan -m "$cur" >/dev/null 2>&1 || true
	[ -n "$LOG" ] && echo "$(date +%T) floor=$cur mem=$2 cpu=$3 gpu=$4 pch=$5" >> "$LOG"
	sleep "$INTERVAL"
done
