# svc:/system/applesmc-fancurve: run applesmc-fancurve(8) in the
# background; stopping the service (SIGTERM to its contract) gives the fans
# back to the SMC (smcfan -s auto).
. /lib/svc/share/smf_include.sh

case "$1" in
start)
	[ -c /dev/applesmc ] || { echo "no /dev/applesmc"; exit $SMF_EXIT_ERR_CONFIG; }
	INTERVAL=`svcprop -p config/interval $SMF_FMRI 2>/dev/null`
	export INTERVAL
	/usr/lib/applesmc/applesmc-fancurve > /dev/null 2>&1 &
	;;
*)
	echo "usage: $0 start"; exit $SMF_EXIT_ERR_CONFIG ;;
esac
exit $SMF_EXIT_OK
