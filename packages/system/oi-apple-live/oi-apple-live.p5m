set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description value="For the OI-Apple installer media and the systems installed from them: X uses the console keyboard and mouse (/dev/kbd, /dev/mouse; the MacBooks' internal keyboard and trackpad through atopcase), and svc:/system/oi-apple-live turns the live-only pieces on in the live system (X on the firmware framebuffer, the Install OpenIndiana launcher) and off on the installed system, where it also hands GDM's automatic login to the installed user at the first boot."
set name=info.classification value="org.opensolaris.category.2008:$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
file path=etc/X11/xorg.conf.d/20-oi-apple-input.conf mode=0444
file path=lib/svc/manifest/system/oi-apple-live.xml mode=0444 \
    restart_fmri=svc:/system/manifest-import:default
file path=lib/svc/method/svc-oi-apple-live mode=0555
file path=usr/bin/oi-apple-install mode=0555
file path=usr/share/applications/oi-apple-install.desktop mode=0444
file path=usr/share/oi-apple/live/10-oi-apple-live-fb.conf mode=0444
