#
# svc:/system/oi-apple-live:default (system/oi-apple-live)
#
# On the OI-Apple live media (/.livecd exists): moves /var/pkg to a tmpfs
# (live_pkg) and turns on the live-only
# pieces, as links in the writable /etc:
#   /etc/X11/xorg.conf.d/10-oi-apple-live-fb.conf   X on the firmware fb
#   /etc/oi-apple/live/oi-apple-install             shows the launcher
#                                                   "Install OpenIndiana"
# On a system installed from the media (the installer copies the live
# system, links included, and removes /.livecd): removes those links, and
# once (first boot) hands GDM's automatic login from the live user to the
# user the installer made, or turns it off.  Report:
# /var/log/oi-apple-firstboot.log.
#
# Both: for the first 3 minutes after boot, clears gdm from maintenance
# (at most 3 times; seen once on the live stick, cause not yet known).
#
. /lib/svc/share/smf_include.sh

FB_LINK=/etc/X11/xorg.conf.d/10-oi-apple-live-fb.conf
FB_CONF=/usr/share/oi-apple/live/10-oi-apple-live-fb.conf
LIVE_DIR=/etc/oi-apple/live
DONE=/etc/oi-apple/.firstboot-done
LOG=/var/log/oi-apple-firstboot.log
GDM=svc:/application/graphical-login/gdm:default

gdm_retry() {
	(
		n=0 t=0
		while [ $t -lt 180 ] && [ $n -lt 3 ]; do
			sleep 10; t=$((t + 10))
			s=$(/usr/bin/svcs -H -o state $GDM 2>/dev/null)
			if [ "$s" = maintenance ]; then
				n=$((n + 1))
				/usr/bin/logger -p daemon.warning -t oi-apple-live \
				    "gdm in maintenance after ${t}s, clearing (try $n)"
				/usr/sbin/svcadm clear $GDM
			fi
		done
	) </dev/null >/dev/null 2>&1 &
}

# pkg on the live media: /var/pkg on the ramdisk is a tree of links into
# the read-only /mnt/misc, on a root with ~130 MB free.  pkg does not
# write through links (ELOOP), and a catalog refresh needs ~1.5 GB (the
# root filled up).  The tree goes to a swap-backed tmpfs, lofs-mounted on
# /var/pkg, with the links pkg rewrites (publisher metadata, catalogs,
# history) turned into copies; manifests and licenses stay links (read
# only).  The installer does not walk into other mounts and takes /var/pkg
# from /mnt/misc, as before.
PKG_TMP=/system/volatile/oi-apple-pkg

live_pkg() {
	/usr/sbin/mount -p | /usr/bin/nawk '$3 == "/var/pkg" { f = 1 }
	    END { exit !f }' && return 0
	/usr/bin/mkdir -p $PKG_TMP || return 1
	/usr/sbin/mount -F tmpfs swap $PKG_TMP || return 1
	(cd /var/pkg && /usr/bin/find . -print |
	    /usr/bin/cpio -pdum $PKG_TMP 2>/dev/null) || return 1
	cd $PKG_TMP || return 1
	for l in $(/usr/bin/find . -type l ! -path './license/*' \
	    ! -path './publisher/*/pkg/*' ! -path './publisher/*/file/*'); do
		t=$(/usr/bin/ls -l $l | /usr/bin/nawk '{ print $NF }')
		/usr/bin/rm -f $l
		/usr/bin/cp -p $t $l || return 1
	done
	cd /
	/usr/sbin/mount -F lofs $PKG_TMP /var/pkg
}

live() {
	/usr/bin/mkdir -p $LIVE_DIR /etc/X11/xorg.conf.d
	/usr/bin/ln -sf /usr/bin/oi-apple-install $LIVE_DIR/oi-apple-install
	/usr/bin/ln -sf $FB_CONF $FB_LINK
	if ! live_pkg; then
		cd /
		/usr/sbin/umount $PKG_TMP 2>/dev/null
		/usr/bin/logger -p daemon.warning -t oi-apple-live \
		    "/var/pkg not moved to tmpfs: pkg cannot change the live system"
	fi
}

installed() {
	/usr/bin/rm -f $FB_LINK $LIVE_DIR/oi-apple-install
	/usr/bin/rmdir $LIVE_DIR 2>/dev/null
	[ -f $DONE ] && return
	exec 3>&1 4>&2 >> $LOG 2>&1
	echo "== OI-Apple first boot, $(/usr/bin/date)"
	# GDM: log in the user the installer created, or nobody (the live
	# media log in their live user "jack").
	C=/etc/gdm/custom.conf
	if [ -f $C ] && /usr/bin/grep -q '^AutomaticLogin=jack$' $C; then
		U=$(/usr/bin/nawk -F: '$3 >= 101 && $3 < 60000 &&
		    $1 != "jack" { print $1; exit }' /etc/passwd)
		if [ -n "$U" ]; then
			/usr/bin/sed "s/^AutomaticLogin=.*/AutomaticLogin=$U/" \
			    $C > $C.new
			echo "GDM logs in $U automatically"
		else
			/usr/bin/sed 's/^AutomaticLoginEnable=.*/AutomaticLoginEnable=False/' \
			    $C > $C.new
			echo "no user found: GDM automatic login off"
		fi
		/usr/bin/mv $C.new $C && /usr/bin/chmod 0644 $C
	fi
	/usr/bin/uname -v
	/usr/bin/pkg publisher 2>&1
	/usr/sbin/zpool status -x 2>&1
	/usr/bin/mkdir -p $(/usr/bin/dirname $DONE) && /usr/bin/touch $DONE
	echo "== done"
	exec 1>&3 2>&4
}

case "$1" in
start)
	if [ -f /.livecd ]; then live; else installed; fi
	gdm_retry
	;;
stop)
	;;
*)
	echo "usage: $0 start|stop"
	exit $SMF_EXIT_ERR_CONFIG
	;;
esac
exit $SMF_EXIT_OK
