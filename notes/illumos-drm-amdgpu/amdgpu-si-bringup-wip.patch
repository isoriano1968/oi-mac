diff --git a/drivers/amdgpu/fetch-and-patch.sh b/drivers/amdgpu/fetch-and-patch.sh
new file mode 100755
index 0000000..4ca4a51
--- /dev/null
+++ b/drivers/amdgpu/fetch-and-patch.sh
@@ -0,0 +1,97 @@
+#!/bin/bash
+#
+# SPDX-License-Identifier: MIT
+# Copyright 2026 The illumos-drm authors
+#
+# Prepares a Linux tree for the amdgpu build, the way
+# drivers/i915/fetch-and-patch.sh does for i915n: checks the pinned commit
+# (PIN), applies misc/drm_kms' patches and then amdgpu's
+# (carried/drm_kms/patches/*.patch, drivers/amdgpu/patches/*.patch),
+# writes the MIT replacements of GPL-2.0 headers amdgpu includes
+# (REPLACED), and copies the MIT headers of mit-headers.txt into
+# <tree>/.illumos/mit-include. The licence check refuses the tree if a
+# TU of tus.txt or a header of mit-headers.txt is not MIT (or offers MIT);
+# build.sh checks every Linux file the compiler read as well.
+#
+# The tree is amdgpu's own (not i915n's: the two series differ), e.g. a
+# git worktree of the i915n tree at the same commit.
+#
+#   drivers/amdgpu/fetch-and-patch.sh <directory>
+set -euo pipefail
+PATH=/usr/gnu/bin:$PATH
+export LC_ALL=C
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+REPO=$(cd "$HERE/../.." && pwd)
+# shellcheck disable=SC1091
+. "$HERE/PIN"
+dest=${1:?usage: fetch-and-patch.sh <directory>}
+AMD=drivers/gpu/drm/amd/amdgpu
+
+if ! git -C "$dest" rev-parse --git-dir >/dev/null 2>&1; then
+	mkdir -p "$dest"
+	git -C "$dest" init -q
+	git -C "$dest" remote add origin "$LINUX_REPO"
+	git -C "$dest" fetch -q --depth 1 origin "$LINUX_REV"
+	git -C "$dest" checkout -q FETCH_HEAD
+fi
+[ "$(git -C "$dest" rev-parse HEAD)" = "$LINUX_REV" ] ||
+    { echo "fetch-and-patch: $dest is not at the pinned $LINUX_REV" >&2; exit 1; }
+
+# tree path, then the MIT replacement relative to the repository
+REPLACED="$AMD/amdgpu_vkms.h drivers/amdgpu/illumos/amdgpu_vkms.h"
+REPLACED="$REPLACED drivers/gpu/drm/display/drm_dp_mst_topology_internal.h"
+REPLACED="$REPLACED carried/drm_kms/illumos/drm_dp_mst_topology_internal.h"
+replaced_paths() { echo $REPLACED | awk '{ for (i = 1; i <= NF; i += 2) print $i }'; }
+
+series=$( (cd "$REPO" && { ls carried/drm_kms/patches/*.patch 2>/dev/null | sort
+    ls drivers/amdgpu/patches/*.patch 2>/dev/null | sort; } || true) )
+sum=$(cd "$REPO" && cat /dev/null $series | sha256sum | cut -d' ' -f1)
+stamp=$dest/.illumos/applied
+if [ -f "$stamp" ] && [ "$(sed -n 1p "$stamp")" = "$sum" ]; then
+	echo "fetch-and-patch: series already applied ($sum)"
+else
+	# shellcheck disable=SC2046
+	git -C "$dest" checkout -- $(replaced_paths)
+	if [ -f "$stamp" ] && [ -d "$dest/.illumos/series" ]; then
+		for p in $(ls "$dest/.illumos/series" | sort -r); do
+			echo "fetch-and-patch: reverting the earlier $p"
+			git -C "$dest" apply -R --whitespace=nowarn "$dest/.illumos/series/$p"
+		done
+		rm -rf "$dest/.illumos/series" "$stamp"
+	fi
+	if [ -n "$(git -C "$dest" status --porcelain --untracked-files=no)" ]; then
+		echo "fetch-and-patch: $dest has changes that are not this series" >&2
+		exit 1
+	fi
+	mkdir -p "$dest/.illumos/series"
+	i=0
+	for p in $series; do
+		i=$((i + 1))
+		echo "fetch-and-patch: applying $p"
+		git -C "$dest" apply --whitespace=nowarn "$REPO/$p"
+		cp "$REPO/$p" "$dest/.illumos/series/$(printf '%03d' $i)-$(basename "$p")"
+	done
+	{ echo "$sum"; echo "$series"; } > "$stamp"
+fi
+
+set -- $REPLACED
+while [ $# -ge 2 ]; do cp "$REPO/$2" "$dest/$1"; shift 2; done
+
+# Licences: the TUs (amdgpu-relative, "/" tree-relative) and the headers.
+{
+	grep -v '^#' "$HERE/tus.txt" | grep . | grep -v '^illumos/' |
+	    sed -e "s|^/||;t" -e "s|^|$AMD/|"
+	grep -v '^#' "$HERE/mit-headers.txt" | grep .
+} | sed 's|/[^/]*/\.\./|/|' > "$dest/.illumos/licence-check.txt"
+python3 "$REPO/drivers/i915/check-licences.py" "$dest" "$dest/.illumos/licence-check.txt"
+
+mit=$dest/.illumos/mit-include
+rm -rf "$mit"
+mkdir -p "$mit"
+grep -v '^#' "$HERE/mit-headers.txt" | grep . | while read -r f; do
+	d=$mit/${f#include/}
+	mkdir -p "$(dirname "$d")"
+	cp "$dest/$f" "$d"
+done
+echo "fetch-and-patch: $dest ready (Linux $LINUX_TAG, $(echo "$series" | grep -c . || true) patches)"
diff --git a/drivers/amdgpu/gen-tus.mk b/drivers/amdgpu/gen-tus.mk
new file mode 100644
index 0000000..77d50cb
--- /dev/null
+++ b/drivers/amdgpu/gen-tus.mk
@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: MIT
+# Copyright 2026 The illumos-drm authors
+#
+# Evaluates Linux's own amdgpu Kbuild Makefiles with GNU make for the
+# illumos configuration (CONFIGS below) and prints the objects of amdgpu.ko
+# as TUs relative to drivers/gpu/drm/amd/amdgpu (gen-tus.sh post-processes
+# them). Nothing of the Makefiles is copied; they are read in place.
+#
+#   gmake -s -f gen-tus.mk LINUX=<tree> print
+src := $(LINUX)/drivers/gpu/drm/amd/amdgpu
+# Southern Islands (GCN 1.0: Tahiti, Pitcairn, Cape Verde, Oland, Hainan)
+CONFIG_DRM_AMDGPU_SI := y
+# Left out for now: CIK, DC (SI display goes through dce_v6_0), KFD, ACP,
+# ISP, HMM, compat ioctls, vga_switcheroo (ATPX is GPL-2.0), ACPI, procfs
+# fdinfo, perf PMU.
+include $(src)/Makefile
+print:
+	@echo $(amdgpu-y)
diff --git a/drivers/amdgpu/gen-tus.sh b/drivers/amdgpu/gen-tus.sh
new file mode 100755
index 0000000..68f7b4f
--- /dev/null
+++ b/drivers/amdgpu/gen-tus.sh
@@ -0,0 +1,67 @@
+#!/bin/bash
+#
+# SPDX-License-Identifier: MIT
+# Copyright 2026 The illumos-drm authors
+#
+# Writes tus.txt: the TUs of amdgpu.ko for the illumos configuration
+# (gen-tus.mk), as paths relative to drivers/gpu/drm/amd/amdgpu, minus
+# the TUs of EXCLUDED (each with its reason), plus the TTM, GPU scheduler
+# and DRM helper TUs amdgpu needs (CARRIED, relative to the tree), which
+# move to their own misc modules once they build.
+#
+#   drivers/amdgpu/gen-tus.sh <patched linux tree> > drivers/amdgpu/tus.txt
+set -euo pipefail
+PATH=/usr/gnu/bin:$PATH
+export LC_ALL=C
+HERE=$(cd "$(dirname "$0")" && pwd)
+LINUX=${1:?usage: gen-tus.sh <linux tree>}
+MAKE=${MAKE:-gmake}
+
+# TU and reason
+EXCLUDED="
+amdgpu_vkms.c	GPL-2.0: MIT stub in illumos/amdgpu_vkms_stub.c
+amdgpu_dma_buf.c	amdgpu's own dma_buf_ops: PRIME is the DRM core's, illumos/amdgpu_dma_buf_illumos.c
+amdgpu_trace_points.c	tracepoints: lkpi has none (no-op trace headers)
+/drivers/gpu/drm/ttm/ttm_bo_vm.c	Linux VM faults (vm_fault, vmf_insert_pfn): replaced by an illumos devmap path (to do)
+/drivers/gpu/drm/ttm/ttm_backup.c	shmem swap-out of BOs: illumos/ttm_backup_illumos.c (none yet)
+
+"
+CARRIED="
+drivers/gpu/drm/ttm/ttm_tt.c
+drivers/gpu/drm/ttm/ttm_bo.c
+drivers/gpu/drm/ttm/ttm_bo_util.c
+drivers/gpu/drm/ttm/ttm_module.c
+drivers/gpu/drm/ttm/ttm_execbuf_util.c
+drivers/gpu/drm/ttm/ttm_range_manager.c
+drivers/gpu/drm/ttm/ttm_resource.c
+drivers/gpu/drm/ttm/ttm_pool.c
+drivers/gpu/drm/ttm/ttm_device.c
+drivers/gpu/drm/ttm/ttm_sys_manager.c
+drivers/gpu/drm/scheduler/sched_main.c
+drivers/gpu/drm/scheduler/sched_fence.c
+drivers/gpu/drm/scheduler/sched_entity.c
+drivers/gpu/drm/scheduler/sched_rq.c
+drivers/gpu/drm/drm_exec.c
+drivers/gpu/buddy.c
+drivers/gpu/drm/drm_buddy.c
+drivers/gpu/drm/drm_suballoc.c
+"
+echo "# Generated by drivers/amdgpu/gen-tus.sh from Linux $(git -C "$LINUX" describe --tags 2>/dev/null || echo '?'); do not edit."
+echo "# amdgpu.ko's TUs (relative to drivers/gpu/drm/amd/amdgpu), then the"
+echo "# carried TUs (relative to the tree, prefix '/'), then illumos/*.c."
+echo "$EXCLUDED" | grep . | sed 's/^\([^\t]*\)\t\(.*\)/# excluded: \1 (\2)/'
+"$MAKE" -s -f "$HERE/gen-tus.mk" LINUX="$LINUX" print | tr ' ' '\n' | grep . |
+    sed 's/\.o$/.c/' | grep -vxF -f <(echo "$EXCLUDED" | grep . | cut -f1) |
+    while read -r t; do
+	# ../pm/x.c -> relative to amd/amdgpu; keep as is (build.sh resolves)
+	[ -f "$LINUX/drivers/gpu/drm/amd/amdgpu/$t" ] ||
+	    { echo "gen-tus.sh: $t not in the tree" >&2; exit 1; }
+	echo "$t"
+    done
+echo "$CARRIED" | grep . | sed 's|^|/|'
+echo "illumos/amdgpu_vkms_stub.c"
+echo "illumos/amdgpu_dma_buf_illumos.c"
+echo "illumos/amdgpu_illumos_kms.c"
+echo "illumos/ttm_backup_illumos.c"
+echo "illumos/amdgpu_illumos.c"
+echo "illumos/amdgpu_illumos_mmap.c"
diff --git a/drivers/amdgpu/illumos/amdgpu_dma_buf_illumos.c b/drivers/amdgpu/illumos/amdgpu_dma_buf_illumos.c
new file mode 100644
index 0000000..364f00c
--- /dev/null
+++ b/drivers/amdgpu/illumos/amdgpu_dma_buf_illumos.c
@@ -0,0 +1,170 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 The illumos-drm authors
+ *
+ * amdgpu's PRIME on illumos, in place of Linux's amdgpu_dma_buf.c (MIT),
+ * which builds amdgpu's own dma_buf_ops (dynamic attachments, peer-to-peer
+ * VRAM, move notification). The DRM core exports and imports dma-bufs
+ * itself, so:
+ *
+ * export	the core's: the facade's object callbacks have no .export
+ *		(patch 0005), amdgpu_gem_prime_export() is not built.
+ *		Another device maps amdgpu's objects through the core's
+ *		PRIME maps (drm_illumos_prime_map()): amdgpu_illumos_prime_pin()
+ *		pins the object in GTT, as Linux's amdgpu_dma_buf_pin() does
+ *		for an importer without peer-to-peer, and hands out the kernel
+ *		mapping of its tt pages (LinuxKPI's one DMA binding per tt).
+ *		Registered from amdgpu_pci_probe() (patch 0013).
+ * import	the core resolves a dma-buf this device exported to the
+ *		exporting object and calls the driver's gem_prime_import only
+ *		for another device's buffer. That one becomes a ttm_bo_type_sg
+ *		object on the buffer's reservation, attached with
+ *		dma_buf_attach() (the import half of Linux's amdgpu_dma_buf.c,
+ *		amdgpu_dma_buf_create_obj()); its tt maps the attachment when it
+ *		is bound (amdgpu_ttm.c, unchanged) and amdgpu_bo_destroy()'s
+ *		drm_prime_gem_destroy() detaches. The attachment is static: the
+ *		buffer stays pinned while mapped, so no move notification.
+ * XGMI		no hive shares memory through an import: false.
+ * amdgpu_dmabuf_ops
+ *	KFD's test for "an amdgpu dma-buf" (amdgpu_amdkfd.c): empty and never
+ *	any dma-buf's ops (the core's dma-bufs have none), so KFD sees no
+ *	amdgpu dma-buf.
+ */
+#include <linux/err.h>
+#include <linux/dma-buf.h>
+#include <drm/drm_gem.h>
+#include <drm/ttm/ttm_tt.h>
+#include <lkpi/dma_pages.h>
+#include <lkpi/prime.h>
+#include "amdgpu.h"
+#include "amdgpu_gem.h"
+#include "amdgpu_dma_buf.h"
+#include "amdgpu_ttm.h"
+
+/* --- export: another device maps one of amdgpu's objects --- */
+
+/* With obj->resv held (by the importer, drm_illumos_prime_map()). */
+static int
+amdgpu_illumos_prime_pin(struct drm_gem_object *obj, void **kaddr)
+{
+	struct amdgpu_bo *bo;
+	struct ttm_tt *ttm;
+	void *k;
+	int r;
+
+	if (obj->funcs != &amdgpu_gem_object_funcs)
+		return (-EINVAL);
+	bo = gem_to_amdgpu_bo(obj);
+	/* As amdgpu_gem_prime_export() refuses these. */
+	if (amdgpu_ttm_tt_get_usermm(bo->tbo.ttm) != NULL ||
+	    (bo->flags & AMDGPU_GEM_CREATE_VM_ALWAYS_VALID) != 0)
+		return (-EPERM);
+	/* An import has no pages of its own: its dma-buf is the exporter's. */
+	if (bo->tbo.type == ttm_bo_type_sg)
+		return (-ENOTSUP);
+	r = amdgpu_bo_pin(bo, AMDGPU_GEM_DOMAIN_GTT);
+	if (r != 0)
+		return (r);
+	ttm = bo->tbo.ttm;
+	k = ttm != NULL ? lkpi_dma_pages_kva(ttm->illumos_dma) : NULL;
+	if (k == NULL) {
+		/* Only the plain pool binds a tt in one piece (patch 0011). */
+		amdgpu_bo_unpin(bo);
+		return (-ENOTSUP);
+	}
+	*kaddr = k;
+	return (0);
+}
+
+static void
+amdgpu_illumos_prime_unpin(struct drm_gem_object *obj)
+{
+	amdgpu_bo_unpin(gem_to_amdgpu_bo(obj));
+}
+
+static const struct drm_illumos_prime_export_funcs amdgpu_illumos_prime_funcs = {
+	.pin = amdgpu_illumos_prime_pin,
+	.unpin = amdgpu_illumos_prime_unpin,
+};
+
+/* From amdgpu_pci_probe() (patch 0013), once the DRM device exists. */
+void
+amdgpu_illumos_prime_init(struct drm_device *ddev)
+{
+	if (lkpi_drm_set_prime_export(ddev, &amdgpu_illumos_prime_funcs) != 0)
+		drm_warn(ddev, "PRIME exports to other devices are off\n");
+}
+
+/* --- import: another device's buffer becomes an amdgpu object --- */
+
+/*
+ * Linux's amdgpu_dma_buf_create_obj() (amdgpu_dma_buf.c, MIT): an object
+ * of type sg on the dma-buf's reservation, GTT only. Another amdgpu
+ * device's buffer passes its caching flags on, as Linux does for
+ * amdgpu_dmabuf_ops (here: an object with amdgpu's GEM functions).
+ */
+static struct drm_gem_object *
+amdgpu_illumos_dma_buf_create_obj(struct drm_device *dev,
+    struct dma_buf *dma_buf)
+{
+	struct dma_resv *resv = dma_buf->resv;
+	struct amdgpu_device *adev = drm_to_adev(dev);
+	struct drm_gem_object *other = dma_buf->priv;
+	struct drm_gem_object *gobj;
+	struct amdgpu_bo *bo;
+	uint64_t flags = 0;
+	int ret;
+
+	dma_resv_lock(resv, NULL);
+	if (other != NULL && other->funcs == &amdgpu_gem_object_funcs) {
+		flags |= gem_to_amdgpu_bo(other)->flags &
+		    (AMDGPU_GEM_CREATE_CPU_GTT_USWC | AMDGPU_GEM_CREATE_COHERENT |
+		    AMDGPU_GEM_CREATE_EXT_COHERENT | AMDGPU_GEM_CREATE_UNCACHED);
+	}
+	ret = amdgpu_gem_object_create(adev, dma_buf->size, PAGE_SIZE,
+	    AMDGPU_GEM_DOMAIN_CPU, flags, ttm_bo_type_sg, resv, &gobj, 0);
+	if (ret != 0) {
+		dma_resv_unlock(resv);
+		return (ERR_PTR(ret));
+	}
+	bo = gem_to_amdgpu_bo(gobj);
+	bo->allowed_domains = AMDGPU_GEM_DOMAIN_GTT;
+	bo->preferred_domains = AMDGPU_GEM_DOMAIN_GTT;
+	dma_resv_unlock(resv);
+	return (gobj);
+}
+
+struct drm_gem_object *
+amdgpu_gem_prime_import(struct drm_device *dev, struct dma_buf *dma_buf)
+{
+	struct drm_gem_object *obj = dma_buf->priv;
+	struct dma_buf_attachment *attach;
+
+	if (obj != NULL && obj->dev == dev &&
+	    obj->funcs == &amdgpu_gem_object_funcs) {
+		drm_gem_object_get(obj);
+		return (obj);
+	}
+	obj = amdgpu_illumos_dma_buf_create_obj(dev, dma_buf);
+	if (IS_ERR(obj))
+		return (obj);
+	attach = dma_buf_attach(dma_buf, dev->dev);
+	if (IS_ERR(attach)) {
+		drm_gem_object_put(obj);
+		return (ERR_CAST(attach));
+	}
+	get_dma_buf(dma_buf);
+	obj->import_attach = attach;
+	return (obj);
+}
+
+const struct dma_buf_ops amdgpu_dmabuf_ops = { 0 };
+
+bool
+amdgpu_dmabuf_is_xgmi_accessible(struct amdgpu_device *adev,
+    struct amdgpu_bo *bo)
+{
+	(void) adev;
+	(void) bo;
+	return (false);
+}
diff --git a/drivers/amdgpu/illumos/amdgpu_illumos.c b/drivers/amdgpu/illumos/amdgpu_illumos.c
new file mode 100644
index 0000000..da23c3c
--- /dev/null
+++ b/drivers/amdgpu/illumos/amdgpu_illumos.c
@@ -0,0 +1,159 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 The illumos-drm authors
+ *
+ * The illumos module of Linux's amdgpu driver: the kernel module "amdgpu",
+ * with mode setting through misc/drm_kms (patch 0014) but no console
+ * takeover yet (Southern Islands first).
+ *
+ * amdgpu's object carries three Linux modules: the GPU buddy allocator
+ * (drivers/gpu/buddy.c), the DRM GPU scheduler (scheduler/sched_fence.c)
+ * and amdgpu itself. build.sh gives the first two their own module_init
+ * names (LKPI_MODULE_INIT), so _init runs them in Linux's load order
+ * (buddy, scheduler, amdgpu) and _fini unwinds them in reverse.
+ *
+ * _init checks the DRM facade and the LinuxKPI layer it was built
+ * against, runs the three module_inits (amdgpu's registers its struct
+ * pci_driver with the layer) and installs the module. attach(9E) and
+ * detach(9E) are the layer's PCI glue with amdgpu's driver; the character
+ * device is the DRM core's (DRM_CB_OPS). Modelled on
+ * drivers/i915/illumos/i915_illumos.c.
+ */
+
+#include <linux/pci.h>
+#include <linux/module.h>
+#include <lkpi/version.h>
+#include <drm/drm_facade.h>
+
+extern int lkpi_module_init_gpu_buddy(void);
+extern void lkpi_module_exit_gpu_buddy(void);
+extern int lkpi_module_init_drm_sched(void);
+extern void lkpi_module_exit_drm_sched(void);
+extern int lkpi_module_init(void);
+extern void lkpi_module_exit(void);
+
+static struct pci_driver *amdgpu_pci_driver;
+
+static int
+amdgpu_illumos_attach(dev_info_t *dip, ddi_attach_cmd_t cmd)
+{
+	if (amdgpu_pci_driver == NULL)
+		return (DDI_FAILURE);
+	return (lkpi_pci_attach(dip, cmd, amdgpu_pci_driver));
+}
+
+static int
+amdgpu_illumos_detach(dev_info_t *dip, ddi_detach_cmd_t cmd)
+{
+	if (amdgpu_pci_driver == NULL)
+		return (DDI_FAILURE);
+	return (lkpi_pci_detach(dip, cmd, amdgpu_pci_driver));
+}
+
+static struct cb_ops amdgpu_cb_ops = DRM_CB_OPS;
+
+static struct dev_ops amdgpu_dev_ops = {
+	.devo_rev = DEVO_REV,
+	.devo_refcnt = 0,
+	.devo_getinfo = drm_getinfo,
+	.devo_identify = nulldev,
+	.devo_probe = nulldev,
+	.devo_attach = amdgpu_illumos_attach,
+	.devo_detach = amdgpu_illumos_detach,
+	.devo_reset = nodev,
+	.devo_cb_ops = &amdgpu_cb_ops,
+	.devo_bus_ops = NULL,
+	.devo_power = NULL,
+	/*
+	 * The GPU keeps running whatever amdgpu left it doing; fast reboot
+	 * is refused rather than handing over a busy GPU.
+	 */
+	.devo_quiesce = ddi_quiesce_not_supported,
+};
+
+static struct modldrv amdgpu_modldrv = {
+	.drv_modops = &mod_driverops,
+	.drv_linkinfo = "AMD GPU (Linux amdgpu)",
+	.drv_dev_ops = &amdgpu_dev_ops,
+};
+
+static struct modlinkage amdgpu_modlinkage = {
+	.ml_rev = MODREV_1,
+	.ml_linkage = { &amdgpu_modldrv, NULL },
+};
+
+/* The carried modules' and amdgpu's exits, newest first. */
+static void
+amdgpu_illumos_exit_from(int level)
+{
+	if (level >= 3)
+		lkpi_module_exit();
+	if (level >= 2)
+		lkpi_module_exit_drm_sched();
+	if (level >= 1)
+		lkpi_module_exit_gpu_buddy();
+}
+
+int
+_init(void)
+{
+	int ret;
+
+	if ((ret = drm_facade_check("amdgpu")) != 0)
+		return (ret);
+	if ((ret = linuxkpi_check("amdgpu", LINUXKPI_ABI)) != 0)
+		return (ret);
+	if ((ret = lkpi_module_init_gpu_buddy()) != 0) {
+		cmn_err(CE_WARN, "amdgpu: buddy allocator init failed (%d)",
+		    ret);
+		goto fail;
+	}
+	if ((ret = lkpi_module_init_drm_sched()) != 0) {
+		cmn_err(CE_WARN, "amdgpu: GPU scheduler init failed (%d)",
+		    ret);
+		amdgpu_illumos_exit_from(1);
+		goto fail;
+	}
+	if ((ret = lkpi_module_init()) != 0) {
+		cmn_err(CE_WARN, "amdgpu: amdgpu module init failed (%d)",
+		    ret);
+		amdgpu_illumos_exit_from(2);
+		goto fail;
+	}
+	amdgpu_pci_driver = lkpi_pci_driver_lookup("amdgpu");
+	if (amdgpu_pci_driver == NULL) {
+		cmn_err(CE_WARN, "amdgpu: amdgpu registered no PCI driver");
+		amdgpu_illumos_exit_from(3);
+		goto fail;
+	}
+	if ((ret = mod_install(&amdgpu_modlinkage)) != 0) {
+		amdgpu_pci_driver = NULL;
+		amdgpu_illumos_exit_from(3);
+		lkpi_module_quiesce(&amdgpu_modlinkage);
+		return (ret);
+	}
+	return (0);
+fail:
+	lkpi_module_quiesce(&amdgpu_modlinkage);
+	return (EINVAL);
+}
+
+int
+_fini(void)
+{
+	int ret;
+
+	if ((ret = mod_remove(&amdgpu_modlinkage)) != 0)
+		return (ret);
+	amdgpu_pci_driver = NULL;
+	amdgpu_illumos_exit_from(3);
+	/* Nothing of the layer may call into this module's text any more. */
+	lkpi_module_quiesce(&amdgpu_modlinkage);
+	return (0);
+}
+
+int
+_info(struct modinfo *mi)
+{
+	return (mod_info(&amdgpu_modlinkage, mi));
+}
diff --git a/drivers/amdgpu/illumos/amdgpu_illumos_kms.c b/drivers/amdgpu/illumos/amdgpu_illumos_kms.c
new file mode 100644
index 0000000..bf73f58
--- /dev/null
+++ b/drivers/amdgpu/illumos/amdgpu_illumos_kms.c
@@ -0,0 +1,64 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 The illumos-drm authors
+ *
+ * What amdgpu needs from Linux modules that are not built for illumos:
+ *
+ * drm_gem_fb_destroy(), drm_gem_fb_create_handle()
+ *	the framebuffer callbacks of Linux's drm_gem_framebuffer_helper.c
+ *	(which carries no licence statement, so it is not built):
+ *	destroy cleans up the framebuffer, drops the references it holds
+ *	on its GEM objects and frees it; create_handle gives the file a
+ *	handle for the first plane's object (MODE_GETFB).
+ * amdgpu_xcp_drm_dev_alloc(), amdgpu_xcp_drm_dev_free(),
+ * amdgpu_xcp_drv_release()
+ *	amdxcp.ko, the DRM devices of compute partitions (MI300 class
+ *	GPUs). Not built: no partition device can be made (-ENODEV), so a
+ *	GPU stays one device; freeing and releasing have nothing to do.
+ */
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include "../amdxcp/amdgpu_xcp_drv.h"
+
+void
+drm_gem_fb_destroy(struct drm_framebuffer *fb)
+{
+	unsigned int i;
+
+	drm_framebuffer_cleanup(fb);
+	for (i = 0; i < ARRAY_SIZE(fb->obj); i++) {
+		if (fb->obj[i] != NULL)
+			drm_gem_object_put(fb->obj[i]);
+	}
+	kfree(fb);
+}
+
+int
+drm_gem_fb_create_handle(struct drm_framebuffer *fb, struct drm_file *file,
+    unsigned int *handle)
+{
+	if (fb->obj[0] == NULL)
+		return (-ENOENT);
+	return (drm_gem_handle_create(file, fb->obj[0], handle));
+}
+
+int
+amdgpu_xcp_drm_dev_alloc(struct drm_device **ddev)
+{
+	*ddev = NULL;
+	return (-ENODEV);
+}
+
+void
+amdgpu_xcp_drm_dev_free(struct drm_device *ddev)
+{
+	(void) ddev;
+}
+
+void
+amdgpu_xcp_drv_release(void)
+{
+}
diff --git a/drivers/amdgpu/illumos/amdgpu_illumos_mmap.c b/drivers/amdgpu/illumos/amdgpu_illumos_mmap.c
new file mode 100644
index 0000000..002722b
--- /dev/null
+++ b/drivers/amdgpu/illumos/amdgpu_illumos_mmap.c
@@ -0,0 +1,353 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 The illumos-drm authors
+ *
+ * User mappings of amdgpu buffer objects through the DRM core, in place
+ * of Linux's amdgpu_gem_fault()/ttm_bo_vm_fault() (ttm_bo_vm.c is not
+ * built). An object shows one of two views to all its user mappings:
+ *
+ * - RAM: the object's user-mapping window (<lkpi/umem_window.h>), kernel
+ *   VA with a umem cookie over the object's TT pages, mapped cached as
+ *   the core maps every umem cookie. Created at the first mmap(2)
+ *   (illumos_umem, with the core's mapping lock held); new mapping
+ *   pieces start on it.
+ * - VRAM: BAR 0 at the object's VRAM offset, write-combined
+ *   (devmap_devmem_remap(9F) with DDI_MERGING_OK_ACC). Only for objects
+ *   that lie contiguous in CPU-visible VRAM: a devmem piece maps one
+ *   contiguous range of a register set. A umem cookie cannot serve VRAM:
+ *   devmap_umem_remap(9F) takes no cache flags, and with the core's
+ *   cached attributes a BAR frame would get a write-back entry whose
+ *   real type then depends on the firmware's MTRRs.
+ *
+ * A fault (illumos_access; the object is movable, so every fault comes
+ * here, without the core's mapping lock) reserves the object and brings
+ * it where the CPU can see it, as Linux's amdgpu_bo_fault_reserve_notify()
+ * does: an object in VRAM that is not contiguous or not CPU-visible moves
+ * to contiguous visible VRAM if that needs no eviction, else to GTT;
+ * objects elsewhere (not VRAM, not system pages) go to GTT. It then waits
+ * for the move, prepares the view (populates and loads the window for
+ * RAM), points every piece at that view if the view changed (or a piece
+ * was added while the view was VRAM), and loads the faulting range, all
+ * with the reservation held.
+ *
+ * The view (struct amdgpu_bo illumos_view_vram, illumos_bar_off) changes
+ * only there, with the reservation held and inside
+ * drm_illumos_gem_foreach_mapping() (the core's mapping lock held), in
+ * the same walk that remaps every piece. The core calls illumos_mapped,
+ * with the mapping lock held, for every new piece: mmap(2) pieces start
+ * on the window, fork(2) and split pieces are copies of a piece that
+ * shows the view. So the invariant "every piece shows the view" can
+ * only break through a new mmap(2) piece while the view is VRAM, which
+ * illumos_mapped records (illumos_remap_pending) for the next fault to
+ * repair; and every fault passes through illumos_access before any
+ * translation is loaded.
+ *
+ * TTM tears CPU mappings down with ttm_bo_unmap_virtual() before pages or
+ * VRAM move or go (moves, swap-out, purge); patch 0009 routes that here
+ * (ttm_bo_illumos_unmap_virtual(), with the reservation held): every user
+ * mapping piece is unloaded, then the window. The view stays; the next
+ * fault compares it with where the object is then.
+ *
+ * GTT pages are kept cached and snooped on illumos (patch 0010,
+ * amdgpu_ttm_tt_create()), because the core maps the window write-back.
+ *
+ * Lock order: reservation, then the core's mapping lock (the unmap and
+ * remap walks take it in drm_illumos_gem_foreach_mapping()).
+ * illumos_umem and illumos_mapped run with the mapping lock held and take
+ * no reservation.
+ */
+
+#include <sys/mman.h>		/* PROT_ALL */
+#include <linux/dma-resv.h>
+#include <lkpi/umem_window.h>
+#include <drm/ttm/ttm_bo.h>
+#include <drm/ttm/ttm_tt.h>
+
+#include "amdgpu.h"
+#include "amdgpu_object.h"
+#include "amdgpu_res_cursor.h"
+#include <drm/drm_illumos.h>	/* after drm_gem.h: its structs */
+
+/* devmap_access(9E) wants an errno; the TTM paths return -errno. */
+static int
+amdgpu_illumos_fault_errno(int r)
+{
+	switch (r) {
+	case -EINTR:
+	case -ERESTARTSYS:
+		return (EINTR);
+	case -ENOMEM:
+		return (ENOMEM);
+	default:
+		return (EFAULT);
+	}
+}
+
+ddi_umem_cookie_t
+amdgpu_illumos_gem_umem(struct drm_gem_object *gobj)
+{
+	struct amdgpu_bo *abo = gem_to_amdgpu_bo(gobj);
+	struct lkpi_umem_window *w = READ_ONCE(abo->illumos_window);
+
+	if (w == NULL) {
+		w = lkpi_umem_window_create(amdgpu_bo_size(abo));
+		if (w == NULL)
+			return (NULL);
+		/* Calls are serialized by the mapping lock; be safe anyway. */
+		if (cmpxchg(&abo->illumos_window, NULL, w) != NULL) {
+			lkpi_umem_window_destroy(w);
+			w = READ_ONCE(abo->illumos_window);
+		}
+	}
+	return (lkpi_umem_window_cookie(w));
+}
+
+/* A new piece (mmap, fork, split); the core's mapping lock is held. */
+int
+amdgpu_illumos_gem_mapped(struct drm_gem_object *gobj,
+    struct drm_illumos_mapping *map)
+{
+	struct amdgpu_bo *abo = gem_to_amdgpu_bo(gobj);
+
+	(void) map;
+	/*
+	 * Copies (fork, split) show what their original showed: the view.
+	 * An mmap(2) piece shows the window, which is the view unless the
+	 * view is VRAM; then the next fault repairs it (it cannot be
+	 * repaired here: the object's VRAM offset is only stable under the
+	 * reservation, which this callback must not take).
+	 */
+	if (abo->illumos_view_vram)
+		abo->illumos_remap_pending = true;
+	return (0);
+}
+
+/* The view the remap walk points every piece at. */
+struct amdgpu_illumos_view {
+	struct amdgpu_bo	*abo;
+	bool			vram;
+	u64			bar_off;
+	int			err;	/* the first failed remap */
+};
+
+/*
+ * Points one piece at the view (drm_illumos_gem_foreach_mapping(), the
+ * mapping lock held). A remap unloads the whole piece; the next access
+ * to any page of it faults again.
+ */
+static void
+amdgpu_illumos_point_piece(struct drm_illumos_mapping *map, void *arg)
+{
+	struct amdgpu_illumos_view *v = arg;
+	struct amdgpu_bo *abo = v->abo;
+	struct amdgpu_device *adev = amdgpu_ttm_adev(abo->tbo.bdev);
+	struct pci_dev *pdev = adev->pdev;
+	devmap_cookie_t dhp = drm_illumos_mapping_cookie(map);
+	offset_t ooff = (offset_t)drm_illumos_mapping_object_offset(map);
+	size_t len = drm_illumos_mapping_len(map);
+	ddi_device_acc_attr_t acc = {
+		.devacc_attr_version = DDI_DEVICE_ATTR_V0,
+		.devacc_attr_endian_flags = DDI_NEVERSWAP_ACC,
+		.devacc_attr_dataorder = DDI_STRICTORDER_ACC,
+	};
+	int r;
+
+	/* The view is the object's from the first piece on (mapping lock). */
+	abo->illumos_view_vram = v->vram;
+	abo->illumos_bar_off = v->bar_off;
+	abo->illumos_remap_pending = false;
+
+	if (v->vram) {
+		/* BAR 0 is the VRAM aperture (gmc_v6_0: aper_base). */
+		acc.devacc_attr_dataorder = DDI_MERGING_OK_ACC;
+		r = devmap_devmem_remap(dhp, pdev->dev.lkpi_dip,
+		    (uint_t)pdev->lkpi_regnum[0],
+		    (offset_t)v->bar_off + ooff, len, PROT_ALL, 0, &acc);
+	} else {
+		/* As at setup: the window, PROT_ALL, flags 0 (cached). */
+		r = devmap_umem_remap(dhp, pdev->dev.lkpi_dip,
+		    lkpi_umem_window_cookie(abo->illumos_window), ooff, len,
+		    PROT_ALL, 0, &acc);
+	}
+	if (r != DDI_SUCCESS && v->err == 0) {
+		v->err = EFAULT;
+		/* This piece shows something else: repair at the next fault. */
+		abo->illumos_remap_pending = true;
+	}
+}
+
+/* Whether the object is in VRAM where BAR 0 can show it in one piece. */
+static bool
+amdgpu_illumos_bar_mappable(struct amdgpu_device *adev,
+    struct ttm_resource *res)
+{
+	return (res != NULL && res->mem_type == TTM_PL_VRAM &&
+	    (res->placement & TTM_PL_FLAG_CONTIGUOUS) != 0 &&
+	    adev->pdev->lkpi_regnum[0] >= 0 &&
+	    amdgpu_res_cpu_visible(adev, res));
+}
+
+/*
+ * Brings the object where the CPU can map it: contiguous visible VRAM,
+ * or system pages. With the reservation held.
+ */
+static int
+amdgpu_illumos_place_for_cpu(struct amdgpu_device *adev,
+    struct amdgpu_bo *abo, struct ttm_operation_ctx *ctx)
+{
+	struct ttm_buffer_object *bo = &abo->tbo;
+	struct ttm_resource *res = bo->resource;
+	u32 domain;
+
+	if (res != NULL && (res->mem_type == TTM_PL_TT ||
+	    res->mem_type == TTM_PL_SYSTEM ||
+	    res->mem_type == AMDGPU_PL_PREEMPT))
+		return (0);
+	if (amdgpu_illumos_bar_mappable(adev, res))
+		return (0);
+	if (bo->pin_count > 0)
+		return (-EFAULT);	/* Linux: VM_FAULT_SIGBUS */
+
+	/* Remember that the CPU accesses it: visible VRAM from now on. */
+	abo->flags |= AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED;
+	domain = abo->allowed_domains & AMDGPU_GEM_DOMAIN_GTT;
+	if (res != NULL && res->mem_type == TTM_PL_VRAM)
+		domain |= AMDGPU_GEM_DOMAIN_VRAM;
+	if (domain == 0)
+		return (-EFAULT);
+	amdgpu_bo_placement_from_domain(abo, domain);
+	if (domain & AMDGPU_GEM_DOMAIN_VRAM) {
+		/* VRAM comes first (amdgpu_bo_placement_from_domain()). */
+		abo->placements[0].flags |= TTM_PL_FLAG_CONTIGUOUS;
+		abo->placements[0].lpfn = min_not_zero(abo->placements[0].lpfn,
+		    (unsigned)(adev->gmc.visible_vram_size >> PAGE_SHIFT));
+		/* As Linux: no eviction for VRAM when GTT will do. */
+		if (domain & AMDGPU_GEM_DOMAIN_GTT)
+			abo->placements[0].flags |= TTM_PL_FLAG_DESIRED;
+	}
+	return (ttm_bo_validate(bo, &abo->placement, ctx));
+}
+
+int
+amdgpu_illumos_gem_access(struct drm_gem_object *gobj,
+    struct drm_illumos_mapping *map, struct drm_illumos_fault *fault)
+{
+	struct amdgpu_bo *abo = gem_to_amdgpu_bo(gobj);
+	struct amdgpu_device *adev = amdgpu_ttm_adev(abo->tbo.bdev);
+	struct ttm_buffer_object *bo = &abo->tbo;
+	struct ttm_operation_ctx ctx = { .interruptible = true };
+	struct lkpi_umem_window *w = READ_ONCE(abo->illumos_window);
+	struct amdgpu_illumos_view v = { .abo = abo };
+	struct amdgpu_res_cursor cursor;
+	long lret;
+	int r;
+
+	(void) map;
+	/*
+	 * An import (ttm_bo_type_sg) has only the exporter's DMA addresses,
+	 * no pages: no CPU mapping, as Linux's TTM fault gives SIGBUS for an
+	 * external tt that is not mappable.
+	 */
+	if (w == NULL || bo->type == ttm_bo_type_sg)
+		return (EFAULT);
+	r = dma_resv_lock_interruptible(bo->base.resv, NULL);
+	if (r != 0)
+		return (amdgpu_illumos_fault_errno(r));
+
+	r = amdgpu_illumos_place_for_cpu(adev, abo, &ctx);
+	if (r != 0)
+		goto out;
+	/* A move (a copy by the GPU) must be done before the CPU looks. */
+	lret = dma_resv_wait_timeout(bo->base.resv, DMA_RESV_USAGE_KERNEL,
+	    true, MAX_SCHEDULE_TIMEOUT);
+	if (lret < 0) {
+		r = (int)lret;
+		goto out;
+	}
+
+	if (bo->resource != NULL && bo->resource->mem_type == TTM_PL_VRAM) {
+		if (!amdgpu_illumos_bar_mappable(adev, bo->resource)) {
+			r = -EFAULT;	/* "should never happen" (Linux) */
+			goto out;
+		}
+		amdgpu_res_first(bo->resource, 0, amdgpu_bo_size(abo),
+		    &cursor);
+		v.vram = true;
+		v.bar_off = cursor.start;
+	} else {
+		if (bo->ttm == NULL || bo->ttm->pages == NULL) {
+			r = -EFAULT;
+			goto out;
+		}
+		r = ttm_bo_populate(bo, &ctx);
+		if (r != 0)
+			goto out;
+		if (!lkpi_umem_window_loaded(w)) {
+			r = lkpi_umem_window_load(w, bo->ttm->pages,
+			    bo->ttm->num_pages);
+			if (r != 0)
+				goto out;
+		}
+	}
+
+	/* Point every piece at the view if it changed or a piece lags. */
+	if (v.vram != abo->illumos_view_vram ||
+	    (v.vram && v.bar_off != abo->illumos_bar_off) ||
+	    READ_ONCE(abo->illumos_remap_pending)) {
+		drm_illumos_gem_foreach_mapping(gobj,
+		    amdgpu_illumos_point_piece, &v);
+		if (v.err != 0) {
+			dma_resv_unlock(bo->base.resv);
+			return (v.err);
+		}
+	}
+
+	/* Loaded with the reservation held: no move can come in between. */
+	r = drm_illumos_fault_load(fault);
+	dma_resv_unlock(bo->base.resv);
+	return (r);
+out:
+	dma_resv_unlock(bo->base.resv);
+	return (amdgpu_illumos_fault_errno(r));
+}
+
+static void
+amdgpu_illumos_unload_piece(struct drm_illumos_mapping *map, void *arg)
+{
+	int r = drm_illumos_mapping_unload(map);
+
+	(void) arg;
+	WARN_ONCE(r != 0, "amdgpu: user mapping not unloaded (%d)", r);
+}
+
+/*
+ * ttm_bo_unmap_virtual() on illumos (patch 0009): the object's pages or
+ * VRAM are about to move or go. The user mappings first, so that no
+ * fault can find the window loaded with the old pages or a piece showing
+ * the old VRAM, then the window. With the reservation held (TTM's
+ * callers hold it), so no fault runs meanwhile.
+ */
+void
+ttm_bo_illumos_unmap_virtual(struct ttm_buffer_object *bo)
+{
+	struct amdgpu_bo *abo;
+	struct lkpi_umem_window *w;
+
+	if (!amdgpu_bo_is_amdgpu_bo(bo))
+		return;
+	abo = ttm_to_amdgpu_bo(bo);
+	w = READ_ONCE(abo->illumos_window);
+	if (w == NULL)
+		return;		/* never mapped */
+	drm_illumos_gem_foreach_mapping(&bo->base,
+	    amdgpu_illumos_unload_piece, NULL);
+	lkpi_umem_window_unload(w);
+}
+
+/* amdgpu_bo_destroy() (patch 0010): no mapping is left. */
+void
+amdgpu_illumos_bo_fini(struct amdgpu_bo *abo)
+{
+	lkpi_umem_window_destroy(abo->illumos_window);
+	abo->illumos_window = NULL;
+}
diff --git a/drivers/amdgpu/illumos/amdgpu_vkms.h b/drivers/amdgpu/illumos/amdgpu_vkms.h
new file mode 100644
index 0000000..cf71e1e
--- /dev/null
+++ b/drivers/amdgpu/illumos/amdgpu_vkms.h
@@ -0,0 +1,17 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 The illumos-drm authors
+ *
+ * The illumos replacement of amdgpu_vkms.h (GPL-2.0+ in Linux), which
+ * fetch-and-patch.sh writes over the tree's file: only the names the MIT
+ * sources use (si.c, cik.c, vi.c, nv.c, soc15.c, amdgpu_discovery.c,
+ * amdgpu.h). The virtual display is not provided on illumos; its IP
+ * block refuses to start (illumos/amdgpu_vkms_stub.c).
+ */
+#ifndef _AMDGPU_VKMS_H_
+#define	_AMDGPU_VKMS_H_
+
+struct amdgpu_vkms_output;
+extern const struct amdgpu_ip_block_version amdgpu_vkms_ip_block;
+
+#endif
diff --git a/drivers/amdgpu/illumos/amdgpu_vkms_stub.c b/drivers/amdgpu/illumos/amdgpu_vkms_stub.c
new file mode 100644
index 0000000..f334e78
--- /dev/null
+++ b/drivers/amdgpu/illumos/amdgpu_vkms_stub.c
@@ -0,0 +1,33 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 The illumos-drm authors
+ *
+ * The virtual display IP block (amdgpu.virtual_display=, SR-IOV guests,
+ * GPUs without a display engine). Linux's amdgpu_vkms.c is GPL-2.0+, so
+ * it is not built; this block fails early_init, and amdgpu then runs
+ * without the virtual display (the module parameter is refused).
+ */
+#include <linux/errno.h>
+#include "amdgpu.h"
+#include "amdgpu_vkms.h"
+
+static int
+amdgpu_vkms_illumos_early_init(struct amdgpu_ip_block *ip_block)
+{
+	dev_err(ip_block->adev->dev,
+	    "virtual display is not available on illumos\n");
+	return (-ENODEV);
+}
+
+static const struct amd_ip_funcs amdgpu_vkms_illumos_funcs = {
+	.name = "amdgpu_vkms",
+	.early_init = amdgpu_vkms_illumos_early_init,
+};
+
+const struct amdgpu_ip_block_version amdgpu_vkms_ip_block = {
+	.type = AMD_IP_BLOCK_TYPE_DCE,
+	.major = 1,
+	.minor = 0,
+	.rev = 0,
+	.funcs = &amdgpu_vkms_illumos_funcs,
+};
diff --git a/drivers/amdgpu/illumos/ttm_backup_illumos.c b/drivers/amdgpu/illumos/ttm_backup_illumos.c
new file mode 100644
index 0000000..14b3628
--- /dev/null
+++ b/drivers/amdgpu/illumos/ttm_backup_illumos.c
@@ -0,0 +1,70 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 The illumos-drm authors
+ *
+ * TTM's backup store (in place of Linux's ttm_backup.c, which writes the
+ * pages of buffer objects that a shrinker takes back to a shmem file and
+ * reads them back). Not provided on illumos yet: no backup space is
+ * available (ttm_backup_bytes_avail() is 0), no backup file can be made
+ * (-EOPNOTSUPP), so TTM never backs a page up and the functions that
+ * handle backed-up pages are not reached. Pages of TTM objects stay in
+ * memory until the objects are freed.
+ */
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <drm/ttm/ttm_backup.h>
+
+void
+ttm_backup_drop(struct file *backup, pgoff_t handle)
+{
+	(void) backup;
+	(void) handle;
+}
+
+int
+ttm_backup_copy_page(struct file *backup, struct page *dst, pgoff_t handle,
+    bool intr, gfp_t additional_gfp)
+{
+	(void) backup;
+	(void) dst;
+	(void) handle;
+	(void) intr;
+	(void) additional_gfp;
+	return (-EOPNOTSUPP);
+}
+
+s64
+ttm_backup_backup_folio(struct file *backup, struct folio *folio,
+    unsigned int order, bool writeback, pgoff_t idx, gfp_t folio_gfp,
+    gfp_t alloc_gfp, pgoff_t *nr_pages_backed)
+{
+	(void) backup;
+	(void) folio;
+	(void) order;
+	(void) writeback;
+	(void) idx;
+	(void) folio_gfp;
+	(void) alloc_gfp;
+	if (nr_pages_backed != NULL)
+		*nr_pages_backed = 0;
+	return (-EOPNOTSUPP);
+}
+
+void
+ttm_backup_fini(struct file *backup)
+{
+	(void) backup;
+}
+
+u64
+ttm_backup_bytes_avail(void)
+{
+	return (0);
+}
+
+struct file *
+ttm_backup_shmem_create(loff_t size)
+{
+	(void) size;
+	return (ERR_PTR(-EOPNOTSUPP));
+}
