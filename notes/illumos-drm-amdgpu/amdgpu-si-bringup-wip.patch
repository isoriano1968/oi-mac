+		return (-EFAULT);
+	w->uw_loaded = true;
+	return (0);
+}
+
+void
+lkpi_umem_window_destroy(struct lkpi_umem_window *w)
+{
+	if (w == NULL)
+		return;
+	lkpi_umem_window_unload(w);
+	gfxp_umem_cookie_destroy(w->uw_cookie);
+	vmem_free(heap_arena, w->uw_va, w->uw_size);
+	kmem_free(w, sizeof (*w));
